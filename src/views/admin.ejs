<%- include('partials/header') %>
<%
  function esc(value) {
    return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function teamOptions(selectedId) {
    return teams.map(function(team) {
      return '<option value="' + esc(team.id) + '"' + (team.id === selectedId ? ' selected' : '') + '>' + esc(team.name) + '</option>';
    }).join('');
  }
  function teamNames(ids) {
    return teams.filter(function(team) { return ids.indexOf(team.id) !== -1; }).map(function(team) { return team.name; }).join(', ');
  }
  /* A dropdown of team checkboxes; `formId` ties them to a form elsewhere in the row. */
  function teamPicker(idPrefix, selectedIds, formId, autoSubmit, label) {
    var html = '<div class="dropdown team-picker">' +
      '<button type="button" class="form-select form-select-sm text-start team-picker-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-popper-config="{&quot;strategy&quot;:&quot;fixed&quot;}" aria-expanded="false" aria-label="' + esc(label) + '">' +
      '<span class="team-picker-label">' + esc(teamNames(selectedIds) || 'Pick teams') + '</span></button>' +
      '<div class="dropdown-menu team-picker-menu p-2">';
    teams.forEach(function(team, i) {
      var id = idPrefix + '-' + i;
      html += '<div class="form-check">' +
        '<input class="form-check-input" type="checkbox" name="teamIds" id="' + id + '" value="' + esc(team.id) + '"' +
        (formId ? ' form="' + esc(formId) + '"' : '') +
        (selectedIds.indexOf(team.id) !== -1 ? ' checked' : '') +
        (autoSubmit ? ' data-submit-on-change' : ' data-team-picker-check') + '>' +
        '<label class="form-check-label small" for="' + id + '">' + esc(team.name) + '</label></div>';
    });
    return html + '</div></div>';
  }
%>
<div class="page-hero page-hero--configuration">
  <div>
    <h2><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Admin</h2>
    <p class="text-muted mb-0">Who can sign in, the teams they plan in, and which team owns each person. Only people on this list can open the app. Members see the teams they belong to; admins see every team.</p>
    <% if (viewTeamId) { %>
      <p class="mb-0 mt-2 small"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Showing <strong><%= viewTeamName %></strong> only. Pick &ldquo;All teams&rdquo; in the top bar to see everyone.</p>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-badge me-2" aria-hidden="true"></i>Users</span>
        <span class="text-muted small"><%= users.length %> on the list<%= viewTeamId ? ' in ' + viewTeamName : '' %></span>
      </div>
      <div class="card-body border-bottom">
        <form method="post" action="/admin/users" class="row g-2 align-items-end" id="newUserForm">
          <div class="col-md-4">
            <label class="form-label small" for="newUserEmail">Email</label>
            <div class="directory-search" data-directory-search>
              <input class="form-control form-control-sm" type="email" id="newUserEmail" name="email" required placeholder="Search Entra ID or type an email" autocomplete="off"
                     role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="newUserSuggestions">
              <ul class="directory-suggestions list-unstyled d-none" id="newUserSuggestions" role="listbox"></ul>
            </div>
          </div>
          <div class="col-md-3">
            <label class="form-label small" for="newUserName">Name</label>
            <input class="form-control form-control-sm" type="text" id="newUserName" name="name" maxlength="120" placeholder="Optional">
          </div>
          <div class="col-md-2">
            <label class="form-label small" for="newUserRole">Role</label>
            <select class="form-select form-select-sm" id="newUserRole" name="role">
              <option value="member" selected>Member</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="col-md-2">
            <span class="form-label small d-block">Teams</span>
            <%- teamPicker('newUserTeam', viewTeamId ? [viewTeamId] : (teams[0] ? [teams[0].id] : []), '', false, 'Teams for the new user') %>
          </div>
          <div class="col-md-1 d-grid">
            <button class="btn btn-primary btn-sm" type="submit" title="Give access"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="visually-hidden">Add user</span></button>
          </div>
        </form>
      </div>
      <div class="card-body p-0">
        <% if (!users.length) { %>
          <p class="text-muted small p-3 mb-0">Nobody is on the list yet. Only the addresses in <code>ADMIN_EMAILS</code> can sign in until you add people here.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 admin-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th class="col-w140">Role</th>
                  <th class="col-w200">Teams</th>
                  <th class="text-end col-w110"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(user, idx) { var formId = 'userForm' + idx; %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= user.name || user.email %>
                        <% if (user.email === me) { %><span class="badge text-bg-light ms-1">You</span><% } %>
                      </div>
                      <% if (user.name) { %><div class="small text-muted"><%= user.email %></div><% } %>
                      <form id="<%= formId %>" method="post" action="/admin/users">
                        <input type="hidden" name="email" value="<%= user.email %>">
                      </form>
                    </td>
                    <td>
                      <% if (user.envAdmin) { %>
                        <span class="role-badge role-badge--admin" title="Set by the ADMIN_EMAILS app setting">Admin</span>
                        <input type="hidden" name="role" value="admin" form="<%= formId %>">
                      <% } else { %>
                        <select class="form-select form-select-sm" name="role" form="<%= formId %>" data-submit-on-change aria-label="Role for <%= user.email %>">
                          <% roles.forEach(function(role) { %>
                            <option value="<%= role %>" <%= role === user.role ? 'selected' : '' %>><%= role === 'admin' ? 'Admin' : 'Member' %></option>
                          <% }) %>
                        </select>
                      <% } %>
                    </td>
                    <td>
                      <%- teamPicker('userTeam' + idx, user.teamIds, formId, true, 'Teams for ' + user.email) %>
                    </td>
                    <td class="text-end">
                      <form method="post" action="/admin/users/remove" class="d-inline" data-confirm="Remove <%= user.email %>? They will no longer be able to open the app.">
                        <input type="hidden" name="email" value="<%= user.email %>">
                        <button class="btn btn-outline-danger btn-sm" type="submit" title="Remove access"><i class="bi bi-person-x" aria-hidden="true"></i><span class="visually-hidden">Remove <%= user.email %></span></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
      <div class="card-footer small text-muted">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        Changes save as soon as you pick a role or team. The last admin cannot be removed or demoted.
        <% if (envAdmins.length) { %>
          Always admins through the <code>ADMIN_EMAILS</code> setting: <%= envAdmins.join(', ') %>.
        <% } else { %>
          Set <code>ADMIN_EMAILS</code> in the app settings to make an address an admin that cannot be removed here.
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>Teams</div>
      <ul class="list-group list-group-flush">
        <% teamStats.forEach(function(team) { %>
          <li class="list-group-item team-row">
            <form method="post" action="/admin/teams/rename" class="d-flex gap-2 align-items-center">
              <input type="hidden" name="teamId" value="<%= team.id %>">
              <input class="form-control form-control-sm" type="text" name="name" value="<%= team.name %>" maxlength="80" required aria-label="Team name">
              <button class="btn btn-outline-secondary btn-sm" type="submit" title="Rename"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="visually-hidden">Rename <%= team.name %></span></button>
            </form>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="small text-muted">
                <%= team.users %> user<%= team.users === 1 ? '' : 's' %> &middot;
                <%= team.people %> <%= team.people === 1 ? 'person' : 'people' %> &middot;
                <%= team.opportunities %> opportunit<%= team.opportunities === 1 ? 'y' : 'ies' %>
                <% if (team.isDefault) { %><span class="badge text-bg-light ms-1" title="Holds everything created before teams existed">Default</span><% } %>
              </span>
              <% if (!team.isDefault) { %>
                <form method="post" action="/admin/teams/remove" data-confirm="Remove the team <%= team.name %>?">
                  <input type="hidden" name="teamId" value="<%= team.id %>">
                  <button class="btn btn-link btn-sm text-danger p-0" type="submit">Remove</button>
                </form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
      <% if (loadError) { %>
        <div class="card-body border-top small text-danger"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Could not count opportunities: <%= loadError %></div>
      <% } %>
      <div class="card-body border-top">
        <form method="post" action="/admin/teams" class="d-flex gap-2">
          <input class="form-control form-control-sm" type="text" name="name" maxlength="80" required placeholder="New team name" aria-label="New team name">
          <button class="btn btn-primary btn-sm text-nowrap" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add team</button>
        </form>
      </div>
    </div>

    <div class="card mt-3" id="roles">
      <div class="card-header"><i class="bi bi-person-badge me-2" aria-hidden="true"></i>Roles</div>
      <div class="card-body small text-muted pb-0">Roles each team gives its people in Configuration. Roles with &ldquo;Lead&rdquo; in the name are left out of team chargeability.</div>
      <ul class="list-group list-group-flush">
        <% teamRoles.forEach(function(team) { %>
          <li class="list-group-item role-team">
            <div class="fw-semibold mb-2"><%= team.name %></div>
            <% if (team.roles.length) { %>
              <div class="role-chips mb-2">
                <% team.roles.forEach(function(role) { %>
                  <span class="role-chip">
                    <span><%= role.title %></span>
                    <% if (role.people) { %><span class="role-chip-count" title="<%= role.people %> <%= role.people === 1 ? 'person has' : 'people have' %> this role"><%= role.people %></span><% } %>
                    <form method="post" action="/admin/roles/remove" class="d-inline"
                          data-confirm="Remove the role <%= role.title %> from <%= team.name %>?<%= role.people ? ' People who have it keep it until changed.' : '' %>" data-confirm-title="Remove role" data-confirm-text="Remove">
                      <input type="hidden" name="teamId" value="<%= team.id %>">
                      <input type="hidden" name="title" value="<%= role.title %>">
                      <button class="role-chip-remove" type="submit" title="Remove <%= role.title %>"><i class="bi bi-x" aria-hidden="true"></i><span class="visually-hidden">Remove <%= role.title %></span></button>
                    </form>
                  </span>
                <% }) %>
              </div>
            <% } else { %>
              <div class="small text-muted mb-2">No roles yet.</div>
            <% } %>
            <form method="post" action="/admin/roles" class="d-flex gap-2">
              <input type="hidden" name="teamId" value="<%= team.id %>">
              <input class="form-control form-control-sm" type="text" name="title" maxlength="80" required placeholder="e.g. Data Scientist" aria-label="New role for <%= team.name %>">
              <button class="btn btn-outline-primary btn-sm text-nowrap" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add role</button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="col-12">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2" aria-hidden="true"></i>People by team</span>
        <span class="text-muted small"><%= people.length %></span>
      </div>
      <div class="card-body p-0 admin-scroll">
        <% if (!people.length) { %>
          <p class="text-muted small p-3 mb-0">No people configured yet. Each team adds its own people under Configuration.</p>
        <% } else { %>
          <div class="admin-people-grid">
            <% people.forEach(function(person) { %>
              <form method="post" action="/admin/people/team" class="admin-person">
                <span class="admin-person-name" title="<%= person.name %>"><%= person.name %></span>
                <input type="hidden" name="person" value="<%= person.name %>">
                <select class="form-select form-select-sm" name="teamId" data-submit-on-change aria-label="Team for <%= person.name %>"><%- teamOptions(person.teamId) %></select>
              </form>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer', { pageScripts: ['/js/admin-directory.js'] }) %>
