<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-gear me-2"></i>Configuration</h2>
    <p class="text-muted mb-0">People, roles, internal cost, absence and daily capacity used for timeline and allocation calculations.</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2"></i>People management</span>
        <span class="text-muted small">Default <%= defaultDailyHours %>h/day &middot; <%= monthlyCapacity %>h/month</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Person</th>
                <th style="width: 240px;">Role</th>
                <th style="width: 110px;">Daily hours</th>
                <th style="width: 140px;">Internal cost</th>
                <th style="width: 130px;">Absence</th>
                <th class="text-end" style="width: 160px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% people.forEach(function(person) { %>
                <% var rowFormId = 'person-form-' + person.name.replace(/[^a-zA-Z0-9]/g, '-') %>
                <% var absenceRowId = 'absence-' + person.name.replace(/[^a-zA-Z0-9]/g, '-') %>
                <% var isOpen = openPerson === person.name %>
                <tr>
                  <td class="fw-semibold">
                    <%= person.name %>
                    <form method="post" action="/settings/people/profile" id="<%= rowFormId %>">
                      <input type="hidden" name="personName" value="<%= person.name %>">
                    </form>
                  </td>
                  <td>
                    <select class="form-select form-select-sm" name="role" form="<%= rowFormId %>">
                      <option value="">Not set</option>
                      <% personRoles.forEach(function(role) { %>
                        <option value="<%= role %>" <%= person.role === role ? 'selected' : '' %>><%= role %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td>
                    <input type="number" class="form-control form-control-sm" name="dailyHours" form="<%= rowFormId %>"
                           min="1" max="24" step="0.5" value="<%= person.dailyHours %>">
                  </td>
                  <td>
                    <div class="input-group input-group-sm">
                      <input type="number" class="form-control" name="internalCost" form="<%= rowFormId %>"
                             min="0" step="0.01" value="<%= person.cost === null ? '' : person.cost %>" placeholder="&mdash;">
                      <span class="input-group-text"><%= costCurrency %></span>
                    </div>
                  </td>
                  <td>
                    <button class="btn btn-sm <%= person.absenceDays ? 'btn-outline-warning' : 'btn-outline-secondary' %>"
                            type="button" data-bs-toggle="collapse" data-bs-target="#<%= absenceRowId %>"
                            aria-expanded="<%= isOpen ? 'true' : 'false' %>" aria-controls="<%= absenceRowId %>">
                      <i class="bi bi-calendar-x me-1"></i><%= person.absenceDays ? person.absenceDays + 'd' : 'None' %>
                    </button>
                  </td>
                  <td class="text-end">
                    <div class="d-flex gap-2 justify-content-end">
                      <button class="btn btn-sm btn-outline-primary" type="submit" form="<%= rowFormId %>">Save</button>
                      <form method="post" action="/settings/people/remove" data-confirm="Remove <%= person.name %> from the people list?" data-confirm-title="Remove person" data-confirm-text="Remove">
                        <input type="hidden" name="personName" value="<%= person.name %>">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <tr class="absence-row">
                  <td colspan="6" class="p-0 border-0">
                    <div class="collapse <%= isOpen ? 'show' : '' %>" id="<%= absenceRowId %>">
                      <div class="absence-panel">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                          <span class="fw-semibold small"><i class="bi bi-calendar-x me-1"></i>Absence for <%= person.name %></span>
                          <span class="text-muted small">
                            <%= person.absenceDays %> working day<%= person.absenceDays === 1 ? '' : 's' %> removed
                            &middot; <%= Math.round(person.absenceDays * person.dailyHours * 100) / 100 %>h off capacity
                          </span>
                        </div>

                        <% if (person.absences.length) { %>
                          <div class="table-responsive mb-2">
                            <table class="table table-sm align-middle mb-0 absence-table">
                              <thead>
                                <tr>
                                  <th style="width: 170px;">Type</th>
                                  <th style="width: 220px;">Dates</th>
                                  <th style="width: 110px;">Working days</th>
                                  <th>Note</th>
                                  <th class="text-end" style="width: 90px;"></th>
                                </tr>
                              </thead>
                              <tbody>
                                <% person.absences.forEach(function(absence) { %>
                                  <tr>
                                    <td><span class="badge text-bg-light border"><%= absence.kind %></span></td>
                                    <td class="text-muted small"><%= absence.startDate %> &rarr; <%= absence.endDate %></td>
                                    <td><%= absence.businessDays %>d</td>
                                    <td class="text-muted small"><%= absence.note || '—' %></td>
                                    <td class="text-end">
                                      <form method="post" action="/settings/people/absences/remove"
                                            data-confirm="Remove this absence? <%= person.name %> becomes available again for <%= absence.startDate %> to <%= absence.endDate %>."
                                            data-confirm-title="Remove absence" data-confirm-text="Remove">
                                        <input type="hidden" name="personName" value="<%= person.name %>">
                                        <input type="hidden" name="absenceId" value="<%= absence.id %>">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                      </form>
                                    </td>
                                  </tr>
                                <% }) %>
                              </tbody>
                            </table>
                          </div>
                        <% } else { %>
                          <p class="text-muted small mb-2">No absence recorded, so the full <%= person.dailyHours %>h/day counts as capacity.</p>
                        <% } %>

                        <form method="post" action="/settings/people/absences" class="row g-2 align-items-end">
                          <input type="hidden" name="personName" value="<%= person.name %>">
                          <div class="col-sm-3">
                            <label class="form-label small mb-1" for="kind-<%= absenceRowId %>">Type</label>
                            <select class="form-select form-select-sm" id="kind-<%= absenceRowId %>" name="kind">
                              <% absenceKinds.forEach(function(kind) { %>
                                <option value="<%= kind %>"><%= kind %></option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="col-sm-2">
                            <label class="form-label small mb-1" for="start-<%= absenceRowId %>">From</label>
                            <input type="date" class="form-control form-control-sm" id="start-<%= absenceRowId %>" name="startDate" required>
                          </div>
                          <div class="col-sm-2">
                            <label class="form-label small mb-1" for="end-<%= absenceRowId %>">To</label>
                            <input type="date" class="form-control form-control-sm" id="end-<%= absenceRowId %>" name="endDate" required>
                          </div>
                          <div class="col-sm-3">
                            <label class="form-label small mb-1" for="note-<%= absenceRowId %>">Note</label>
                            <input class="form-control form-control-sm" id="note-<%= absenceRowId %>" name="note" maxlength="200" placeholder="Optional">
                          </div>
                          <div class="col-sm-2">
                            <button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-plus-lg me-1"></i>Add</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!people.length) { %>
                <tr><td colspan="6" class="text-center text-muted py-4">No people configured yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-shield-check me-2"></i>Capacity booking rule</div>
      <div class="card-body">
        <p class="text-muted small">
          Pick the stages whose assignments consume a person's real capacity. Opportunities in any
          other stage are treated as <strong>soft bookings</strong>: they still appear on the timeline
          but do not reduce available hours until they progress. Individual opportunities can override
          this from the pipeline.
        </p>
        <form method="post" action="/settings/capacity/stages">
          <div class="row g-2">
            <% stages.forEach(function(stage) { %>
              <div class="col-sm-6 col-lg-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="firmStages" value="<%= stage %>"
                         id="firm-<%= stage %>" <%= firmStages.indexOf(stage) !== -1 ? 'checked' : '' %>>
                  <label class="form-check-label" for="firm-<%= stage %>"><%= stage %></label>
                </div>
              </div>
            <% }) %>
          </div>
          <button class="btn btn-primary mt-3" type="submit"><i class="bi bi-check-lg me-1"></i>Save booking rule</button>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header"><i class="bi bi-person-plus me-2"></i>Add person</div>
      <div class="card-body">
        <form method="post" action="/settings/people" class="row g-3">
          <div class="col-12">
            <label class="form-label" for="personName">Name</label>
            <input class="form-control" id="personName" name="personName" required placeholder="Full name">
          </div>
          <div class="col-12">
            <label class="form-label" for="role">Role</label>
            <select class="form-select" id="role" name="role">
              <option value="">Not set</option>
              <% personRoles.forEach(function(role) { %>
                <option value="<%= role %>"><%= role %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label" for="dailyHours">Daily hours</label>
            <input type="number" class="form-control" id="dailyHours" name="dailyHours" min="1" max="24" step="0.5" value="8" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="internalCost">Internal cost (<%= costCurrency %>)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="internalCost" name="internalCost" min="0" step="0.01" placeholder="Optional">
              <span class="input-group-text"><%= costCurrency %></span>
            </div>
          </div>
          <div class="col-12">
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-plus-lg me-1"></i>Add person</button>
          </div>
        </form>
        <p class="text-muted small mb-0 mt-3">
          Settings are stored in <code>config.local.json</code> at the repository root, so they are shared by everyone using this server.
        </p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
