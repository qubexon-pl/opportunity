<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-person-badge me-2"></i><%= detail.person %></h2>
    <p class="text-muted mb-0">
      <% if (detail.member) { %>
        <% if (detail.member.role) { %><%= detail.member.role %> &middot; <% } %>
        <%= detail.member.dailyHours %>h/day
        <% if (detail.cost !== null) { %> &middot; <%= detail.cost %> <%= detail.costCurrency %> internal cost<% } %>
        &middot;
      <% } %>
      <%= detail.windowStartText %> &rarr; <%= detail.windowEndText %>
      (<%= detail.capacityBusinessDays %> working days<% if (detail.member && detail.member.absentDays > 0) { %>, <%= detail.member.absentDays %> absent<% } %>)
    </p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/management?applied=1&perspective=<%= perspective %>&units=<%= unitsToShow %>">
      <i class="bi bi-arrow-left me-1"></i>Back to capacity
    </a>
  </div>
</div>

<% if (typeof loadError !== 'undefined' && loadError) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>Could not load assignment data: <%= loadError %>
  </div>
<% } %>

<% if (!detail.isKnown) { %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i><%= detail.person %> is not configured and has no assignments.
    Add them in <a href="/settings">Configuration</a>.
  </div>
<% } else { %>

<div class="card mb-4">
  <div class="card-header">
    <a class="card-collapse-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#collapsePeriod" aria-expanded="false">
      <i class="bi bi-chevron-down"></i><span><i class="bi bi-sliders me-2"></i>Period</span>
    </a>
  </div>
  <div class="card-body collapse" id="collapsePeriod">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-lg-3 col-md-4 col-6">
        <label class="form-label" for="perspective">Timeline unit</label>
        <select class="form-select" id="perspective" name="perspective">
          <% timelineUnitOptions.forEach(function(option) { %>
            <option value="<%= option.key %>" <%= perspective === option.key ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-3 col-md-4 col-6">
        <label class="form-label" for="units">Horizon (units)</label>
        <input type="number" class="form-control" id="units" name="units" min="1" max="24" value="<%= unitsToShow %>">
      </div>
      <div class="col-lg-3 col-md-4">
        <button class="btn btn-primary" type="submit"><i class="bi bi-arrow-clockwise me-1"></i>Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-3 col-md-6">
    <div class="card h-100"><div class="card-body">
      <div class="kpi-label">Capacity</div>
      <div class="kpi-value"><%= detail.member.capacityHours %>h</div>
      <div class="text-muted small">
        <%= detail.capacityBusinessDays - detail.member.absentDays %> working days
        <% if (detail.member.absentDays > 0) { %>
          &middot; <%= detail.member.absentDays %>d absent
        <% } %>
      </div>
    </div></div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card h-100"><div class="card-body">
      <div class="kpi-label">Committed</div>
      <div class="kpi-value <%= detail.member.chargeabilityClass %>"><%= detail.member.activeHours %>h</div>
      <div class="text-muted small"><%= detail.member.chargeabilityReal %>% utilization</div>
    </div></div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card h-100"><div class="card-body">
      <div class="kpi-label">Free</div>
      <div class="kpi-value <%= capacityClass(detail.member.availableHours) %>"><%= detail.member.availableHours %>h</div>
      <div class="text-muted small">
        <%= detail.member.softHours %>h soft booked &middot; <%= detail.member.availableIfWonHours %>h if all won
      </div>
    </div></div>
  </div>
  <div class="col-lg-3 col-md-6">
    <div class="card h-100"><div class="card-body">
      <div class="kpi-label">Released by holds</div>
      <div class="kpi-value"><%= detail.member.heldHours %>h</div>
      <div class="text-muted small">
        <% if (detail.member.heldHours > 0) { %>
          <%= detail.member.chargeabilityReal %>% instead of <%= detail.member.chargeabilityWithoutHolds %>%
          (&minus;<%= detail.member.holdPercentPoints %> pts)
        <% } else { %>
          Nothing on hold in this window
        <% } %>
      </div>
    </div></div>
  </div>
</div>

<%- include('partials/person-absences') %>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a class="card-collapse-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#collapseCapacityPeriod" aria-expanded="false">
      <i class="bi bi-chevron-down"></i><span><i class="bi bi-calendar3 me-2"></i>Capacity by period</span>
    </a>
    <span class="text-muted small">Committed + free = capacity, so each row is 100%</span>
  </div>
  <div class="card-body collapse p-0" id="collapseCapacityPeriod">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 person-period-table">
        <thead>
          <tr>
            <th>Period</th>
            <th class="text-end">Capacity</th>
            <th class="text-end">Committed</th>
            <th class="text-end">Free</th>
            <th class="text-end">Soft</th>
            <th style="width: 130px;">Split</th>
            <th>Breakdown</th>
          </tr>
        </thead>
        <tbody>
          <% detail.periods.forEach(function(period) { %>
            <% var fullyAbsent = period.capacityHours === 0 && period.absentDays > 0 %>
            <tr class="<%= fullyAbsent ? 'period-absent' : '' %>">
              <td class="text-nowrap">
                <span class="fw-semibold"><%= period.label %></span>
                <div class="text-muted small">
                  <%= period.groupLabel %> &middot; <%= period.businessDays - period.absentDays %>d
                  <% if (period.absentDays) { %><span class="absence-hint">&middot; <%= period.absentDays %>d away</span><% } %>
                </div>
              </td>
              <td class="text-end">
                <%= period.capacityHours %>h
                <% if (period.absentDays) { %>
                  <div class="absence-hint small" title="<%= period.absences.map(function(a) { return a.kind + ' ' + a.startDate + ' to ' + a.endDate; }).join('\n') %>">
                    &minus;<%= period.absenceHours %>h absence
                  </div>
                <% } %>
              </td>
              <% if (fullyAbsent) { %>
                <td class="text-muted text-center" colspan="5">
                  <i class="bi bi-calendar-x me-1"></i>Away for the whole period, so there is no capacity to share out
                </td>
              <% } else { %>
                <td class="text-end"><%= period.committedHours %>h <span class="text-muted small">(<%= period.usedPercent %>%)</span></td>
                <td class="text-end <%= capacityClass(period.freeHours) %>"><%= period.freeHours %>h <span class="text-muted small">(<%= period.freePercent %>%)</span></td>
                <td class="text-end"><% if (period.softHours) { %><span class="soft-hint"><%= period.softHours %>h (<%= period.softPercent %>%)</span><% } else { %><span class="text-muted">-</span><% } %></td>
                <td>
                  <div class="person-split" title="<%= period.usedPercent %>% committed, <%= period.freePercent %>% free">
                    <div class="person-split-used" style="width: <%= Math.min(100, period.usedPercent) %>%;"></div>
                    <div class="person-split-soft" style="width: <%= Math.max(0, Math.min(100 - Math.min(100, period.usedPercent), period.softPercent)) %>%;"></div>
                  </div>
                </td>
                <td class="small">
                  <% if (period.parts.length) { %>
                    <% period.parts.forEach(function(part) { %>
                      <div><%= part.name %>: <%= part.hours %>h &middot; <%= part.percent %>%</div>
                    <% }) %>
                  <% } %>
                  <div class="text-muted">Free: <%= period.freeHours %>h &middot; <%= period.freePercent %>%</div>
                </td>
              <% } %>
            </tr>
          <% }) %>
          <% if (!detail.periods.length) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">No periods in this window.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a class="card-collapse-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#collapseAllocations" aria-expanded="false">
      <i class="bi bi-chevron-down"></i><span><i class="bi bi-list-check me-2"></i>Allocations in this period (<%= detail.inWindow.length %>)</span>
    </a>
    <% if (detail.hiddenCount) { %>
      <span class="text-muted small"><%= detail.hiddenCount %> hidden from the timeline</span>
    <% } %>
  </div>
  <div class="card-body collapse p-0" id="collapseAllocations">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Opportunity</th>
            <th>Stage</th>
            <th>Window</th>
            <th class="text-end">Project Allocation</th>
            <th class="text-end">Hours on the bar</th>
            <th class="text-end">In this period</th>
            <th class="text-end">% of capacity</th>
          </tr>
        </thead>
        <tbody>
          <% detail.inWindow.forEach(function(row) { %>
            <tr>
              <td>
                <a href="/opportunities/<%= row.OpportunityId %>#assignments"><%= row.OpportunityName %></a>
                <% if (!row.IsCommitted) { %><span class="booking-state is-soft ms-1">Soft</span><% } %>
                <% if (!row.IsTimelineVisible) { %><span class="text-muted small ms-1">(hidden)</span><% } %>
              </td>
              <td><span class="stage-dot <%= stageAccentClass(row.Stage) %>"></span><%= row.Stage || '-' %></td>
              <td class="text-nowrap">
                <%= row.StartDate || '-' %> &rarr; <%= row.EndDate || '-' %>
                <div class="text-muted small"><%= row.businessDays %> working days</div>
                <% if (row.hasHolds) { %>
                  <% (row.holds || []).forEach(function(hold) { %>
                    <div class="hold-hint small<%= isHoldExpired(hold) ? ' text-decoration-line-through text-muted' : '' %>">
                      <i class="bi bi-pause-circle me-1"></i>On hold <%= hold.startDate %> &rarr; <%= hold.endDate %>
                    </div>
                  <% }) %>
                  <% if (row.releasedByHoldHours > 0) { %>
                    <div class="text-muted small">Holds free <%= row.releasedByHoldHours %>h</div>
                  <% } %>
                <% } %>
              </td>
              <td class="text-end" title="<%= row.InitialAllocatedHours %>h of the <%= row.OpportunityHours %>h project scope">
                <%= row.InitialAllocatedHours %>h &middot; <%= row.InitialPercent %>%
              </td>
              <td class="text-end"><%= row.AllocatedHours %>h<% if (row.IsResized) { %> <span class="text-muted small">(resized)</span><% } %></td>
              <td class="text-end fw-semibold"><%= row.windowHours %>h</td>
              <td class="text-end"><%= row.capacityPercent %>%</td>
            </tr>
          <% }) %>
          <% if (!detail.inWindow.length) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">Nothing allocated in this period.</td></tr>
          <% } %>
        </tbody>
        <% if (detail.inWindow.length) { %>
          <tfoot>
            <tr class="fw-semibold">
              <td colspan="5" class="text-end">Committed in this period</td>
              <td class="text-end"><%= detail.member.activeHours %>h</td>
              <td class="text-end"><%= detail.member.chargeabilityReal %>%</td>
            </tr>
            <tr>
              <td colspan="5" class="text-end text-muted">Free</td>
              <td class="text-end text-muted"><%= detail.member.availableHours %>h</td>
              <td class="text-end text-muted"><%= (100 - detail.member.chargeabilityReal).toFixed(2) %>%</td>
            </tr>
          </tfoot>
        <% } %>
      </table>
    </div>
  </div>
  <% if (detail.outsideWindow.length) { %>
    <div class="card-footer text-muted small">
      <%= detail.outsideWindow.length %> further allocation<%= detail.outsideWindow.length === 1 ? '' : 's' %>
      fall<%= detail.outsideWindow.length === 1 ? 's' : '' %> outside this period.
    </div>
  <% } %>
</div>

<div class="mt-4"></div>

<div class="card mb-4">
  <div class="card-header">
    <a class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapsePersonTimeline" aria-expanded="true">
      <i class="bi bi-chevron-down"></i><span><i class="bi bi-bar-chart-steps me-2"></i>Timeline</span>
    </a>
  </div>
  <div class="card-body collapse show" id="collapsePersonTimeline">
    <% if (timeline && timeline.rows.length) { %>
    <div class="timeline-scroll" data-scroll-key="person-timeline">
      <div class="timeline-grid" id="timelineGrid"
           data-perspective="<%= timeline.perspective %>"
           data-range-start="<%= timeline.startText %>"
           data-range-end-exclusive="<%= timeline.endExclusiveText %>"
           data-window-start="<%= timeline.windowStartText %>"
           data-window-end-exclusive="<%= timeline.windowEndExclusiveText %>"
           style="--timeline-units: <%= timeline.units.length %>;">
        <div class="timeline-head">
          <div class="timeline-person-head">Person</div>
          <div class="timeline-head-stack">
            <div class="timeline-groups" style="--timeline-units: <%= timeline.units.length %>;">
              <% timeline.unitGroups.forEach(function(group) { %>
                <div class="timeline-group" style="--group-span: <%= group.span %>;"><span><%= group.label %></span></div>
              <% }) %>
            </div>
            <div class="timeline-units" style="--timeline-units: <%= timeline.units.length %>;">
              <% timeline.units.forEach(function(unit) { %>
                <div class="timeline-unit"><%= unit.label %></div>
              <% }) %>
            </div>
          </div>
        </div>
        <% timeline.rows.forEach(function(row) { %>
          <div class="timeline-row" style="height: <%= row.height %>px;">
            <div class="timeline-person"
                 title="<%= row.person %> &middot; <%= row.capacityHours %>h capacity in this window
Committed: <%= row.committedHours %>h
Free: <%= row.freeHours %>h
Committed + free = <%= (row.committedHours + row.freeHours).toFixed(2) %>h
Soft booked on top: <%= row.softHours %>h<%= row.heldHours ? '\nReleased by holds: ' + row.heldHours + 'h' : '' %><%
%><% if (row.absentDays) { %>
Away <%= row.absentDays %>d, which removes <%= row.absenceHours %>h of capacity:<% row.absenceBands.forEach(function(band) { %>
  <%= band.kind %> <%= band.startDate %> &rarr; <%= band.endDate %> (<%= band.daysInWindow %>d in view)<% }) %><% } %>">
              <span class="person-link"><%= row.person %></span>
              <span class="timeline-person-load"><%= row.committedHours %>h / <%= row.capacityHours %>h (<%= row.utilizationPercent %>%)</span>
            </div>
            <div class="timeline-lane" style="--timeline-units: <%= timeline.units.length %>;">
              <div class="timeline-gridlines">
                <% timeline.units.forEach(function(unit) { %><div class="timeline-gridline"></div><% }) %>
              </div>
              <% row.chips.forEach(function(chip) { %>
                <div class="timeline-chip <%= chip.accentClass %> <%= chip.IsCommitted ? 'is-committed' : 'is-soft' %> <%= chip.IsOnHold ? 'is-on-hold' : '' %>"
                     data-assignment-id="<%= chip.Id %>"
                     data-opportunity-id="<%= chip.OpportunityId %>"
                     data-start="<%= chip.StartDate %>"
                     data-end="<%= chip.EndDate %>"
                     data-percent="<%= chip.AllocationPercent || 0 %>"
                     data-hours="<%= chip.AllocatedHours %>"
                     data-initial-hours="<%= chip.InitialAllocatedHours %>"
                     data-initial-percent="<%= chip.InitialPercent %>"
                     data-opportunity-hours="<%= chip.OpportunityHours %>"
                     data-capacity-hours="<%= row.capacityHours %>"
                     data-capacity-percent="<%= chip.capacityPercent %>"
                     data-holds="<%= chip.holds ? JSON.stringify(chip.holds) : '[]' %>"
                     data-stage-label="<%= stageStatusLabel(chip.Stage) %>"
                     data-person="<%= chip.PersonName %>"
                     style="left: <%= chip.geometry.left.toFixed(3) %>%; width: <%= chip.geometry.width.toFixed(3) %>%; top: <%= chip.geometry.top %>px;"
                     title="<%= chip.OpportunityName %> &middot; <%= chip.PersonName %>
<%= chip.StartDate %> &rarr; <%= chip.EndDate %> (<%= chip.businessDays %> working days)
Assigned: <%= chip.InitialAllocatedHours %>h = <%= chip.InitialPercent %>% of the <%= chip.OpportunityHours %>h project
Now on the bar: <%= chip.AllocatedHours %>h<%= chip.IsResized ? ' (resized)' : '' %>
In this window: <%= chip.windowHours %>h = <%= chip.capacityPercent %>% of <%= row.person %>'s <%= row.capacityHours %>h capacity<%= chip.IsCommitted ? '' : '\nSoft booking: does not consume capacity yet' %>">
                  <span class="timeline-chip-resizer start" data-edge="start" title="Drag to change the start date"></span>
                  <% chip.holdOverlays.forEach(function(hold) { %>
                    <span class="timeline-chip-hold"
                          style="left: <%= hold.left.toFixed(3) %>%; width: <%= hold.width.toFixed(3) %>%;"
                          title="On hold <%= hold.startDate %> &rarr; <%= hold.endDate %> (capacity free)"></span>
                  <% }) %>
                  <a class="timeline-chip-body" href="/opportunities/<%= chip.OpportunityId %>#assignments">
                    <span class="timeline-chip-title">
                      <% if (chip.IsOnHold) { %><i class="bi bi-pause-circle me-1"></i><% } %><% if (!chip.IsCommitted) { %><i class="bi bi-hourglass-split me-1"></i><% } %><%= chip.OpportunityName %><%
                      %><span class="timeline-chip-stage <%= chip.accentClass %>"><%= stageStatusLabel(chip.Stage) %></span>
                    </span>
                    <span class="timeline-chip-meta" data-role="meta"><%
                      %><%= chip.InitialAllocatedHours %>h<%
                      %><% if (chip.IsResized) { %> &rarr; <%= chip.AllocatedHours %>h<% } %><%
                      %> &middot; <%= chip.capacityPercent %>% cap</span>
                  </a>
                  <span class="timeline-chip-resizer end" data-edge="end" title="Drag to change the end date"></span>
                </div>
              <% }) %>
              <% row.freeChips.forEach(function(segment) { %>
                <%
                  var breakdown = segment.parts.map(function(part) {
                    return part.name + ': ' + part.hours + 'h = ' + part.percent + '%';
                  }).concat(['Free: ' + segment.freeHours + 'h = ' + segment.freePercent + '%']).join('\n');
                  var fullyAbsent = segment.capacityHours === 0 && segment.absentDays > 0;
                  var absenceDetail = segment.absentDays
                    ? '\n' + segment.absences.map(function(a) {
                        return a.kind + ' ' + a.startDate + ' to ' + a.endDate + ' (' + a.daysInWindow + 'd here)';
                      }).join('\n')
                    : '';
                %>
                <div class="timeline-free<%= fullyAbsent ? ' is-absent' : '' %><%= segment.isOver ? ' is-over' : '' %>"
                     style="left: <%= segment.geometry.left.toFixed(3) %>%; width: <%= segment.geometry.width.toFixed(3) %>%; top: <%= segment.geometry.top %>px;"
                     title="<%= segment.groupLabel %> <%= segment.unitLabel %> &middot; <%= segment.capacityHours %>h capacity<%= segment.absentDays ? ' (' + segment.grossCapacityHours + 'h \u2212 ' + segment.absenceHours + 'h absence)' : '' %><%= fullyAbsent ? '\nAway for the whole period, so there is no capacity to share out.' : '\n' + breakdown + '\nTotal: ' + (segment.usedPercent + segment.freePercent).toFixed(2) + '%' %><%= segment.isOver ? '\nOver capacity by ' + segment.overHours + 'h: more is committed here than there are hours to give.' : '' %><%= segment.softHours ? '\nSoft booked on top: ' + segment.softHours + 'h = ' + segment.softPercent + '%' : '' %><%= absenceDetail %>">
                  <span class="timeline-free-label">
                    <% if (fullyAbsent) { %>
                      <span class="timeline-free-primary">Away <%= segment.absentDays %>d</span>
                      <span class="timeline-free-secondary">no capacity</span>
                    <% } else if (segment.isOver) { %>
                      <span class="timeline-free-primary">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i><%= segment.overHours %>h over
                      </span>
                      <span class="timeline-free-secondary"><%= segment.usedPercent %>%<% if (segment.absentDays) { %> &middot; <%= segment.absentDays %>d away<% } %></span>
                    <% } else { %>
                      <span class="timeline-free-primary"><%= segment.freeHours %>h free</span>
                      <span class="timeline-free-secondary"><%= segment.freePercent %>%<% if (segment.softHours) { %> &middot; <%= segment.softHours %>h soft<% } %><% if (segment.absentDays) { %> &middot; <%= segment.absentDays %>d away<% } %></span>
                    <% } %>
                  </span>
                </div>
              <% }) %>
              <% row.absenceBands.forEach(function(band) { %>
                <%
                  var bandRange = band.startDate + ' \u2192 ' + band.endDate;
                %>
                <div class="timeline-absence"
                     style="left: <%= band.geometry.left.toFixed(3) %>%; width: <%= band.geometry.width.toFixed(3) %>%; top: <%= band.geometry.top %>px;"
                     title="<%= band.kind %><%= band.note ? ' \u2014 ' + band.note : '' %>
<%= bandRange %><%= band.startsBefore || band.endsAfter ? ' (continues outside this window)' : '' %>
<%= band.daysInWindow %> working days here, removing <%= band.hours %>h of capacity">
                  <span class="timeline-absence-label">
                    <%= band.daysInWindow %>d off
                  </span>
                </div>
              <% }) %>
              <% if (!row.chips.length && !row.freeChips.length && !row.absenceBands.length) { %>
                <div class="timeline-empty">No scheduled work in this window</div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">Nothing to display for this person in the selected window.</div>
    <% } %>
  </div>
</div>

<% } %>

<script src="/js/person-absences.js"></script>
<script src="/js/timeline.js"></script>
<%- include('partials/footer') %>
