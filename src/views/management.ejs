<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">  <div>
    <h2><i class="bi bi-diagram-3 me-2"></i>Team capacity</h2>
    <p class="text-muted mb-0">
      Capacity window: <%= toDateText(view.window.start) %> &rarr; <%= toDateText(view.window.endExclusive) %>
      (<%= view.capacityBusinessDays %> working days, baseline <%= monthlyCapacity %>h/month).
    </p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <span class="badge text-bg-secondary">Assignments: <%= view.stats.total %></span>
    <span class="badge text-bg-success">Committed: <%= view.stats.committed %></span>
    <span class="badge text-bg-warning">Soft booked: <%= view.stats.soft %></span>
    <span class="badge text-bg-info">On hold: <%= view.stats.onHold %></span>
    <span class="badge text-bg-light">Hidden: <%= view.stats.hidden %></span>
  </div>
</div>

<% if (typeof loadError !== 'undefined' && loadError) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>Could not load assignment data: <%= loadError %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-sliders me-2"></i>Perspective</div>
  <div class="card-body">
    <form method="get" action="/management" class="row g-3 align-items-end">
      <input type="hidden" name="applied" value="1">
      <div class="col-lg-3 col-md-4 col-6">
        <label class="form-label" for="perspective">Timeline unit</label>
        <select class="form-select" id="perspective" name="perspective">
          <% timelineUnitOptions.forEach(function(option) { %>
            <option value="<%= option.key %>" <%= perspective === option.key ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-3 col-md-4 col-6">
        <label class="form-label" for="units">Horizon (units)</label>
        <input type="number" class="form-control" id="units" name="units" min="1" max="24" value="<%= unitsToShow %>">
      </div>
      <div class="col-lg-3 col-md-4 col-6">
        <%- include('partials/multiselect', {
          id: 'filter-timeline-stage',
          name: 'stage',
          label: 'Stage filter',
          allLabel: 'All stages',
          selected: stageFilters,
          options: [{ value: 'free', label: 'Free capacity' }].concat(stageLegend.map(function(item) {
            return { value: item.label, label: item.label };
          }))
        }) %>
      </div>
      <div class="col-lg-3 col-md-4 col-6">
        <%- include('partials/multiselect', {
          id: 'filter-timeline-person',
          name: 'person',
          label: 'Person',
          allLabel: 'All people',
          selected: personFilters,
          options: personOptions.map(function(name) { return { value: name, label: name }; })
        }) %>
      </div>
      <div class="col-lg-12 col-md-8 d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-arrow-clockwise me-1"></i>Apply</button>
        <a class="btn btn-outline-secondary" href="/management?applied=1" title="Reset"><i class="bi bi-x-lg"></i></a>
      </div>
    </form>
    <form method="post" action="/management/defaults" class="mt-3 d-flex align-items-center gap-2 flex-wrap">
      <input type="hidden" name="perspective" value="<%= perspective %>">
      <input type="hidden" name="units" value="<%= unitsToShow %>">
      <% stageFilters.forEach(function(stage) { %><input type="hidden" name="stage" value="<%= stage %>"><% }) %>
      <% personFilters.forEach(function(name) { %><input type="hidden" name="person" value="<%= name %>"><% }) %>
      <button class="btn btn-sm btn-outline-primary" type="submit" <%= filtersMatchDefault ? 'disabled' : '' %>>
        <i class="bi bi-pin-angle me-1"></i>Save as my default
      </button>
      <span class="text-muted small">
        Current default: <%= savedDefaults.perspective %> &middot; <%= savedDefaults.units %> units &middot;
        <%= savedDefaults.stages.length ? savedDefaults.stages.join(', ') : 'all stages' %> &middot;
        <%= savedDefaults.people.length ? savedDefaults.people.join(', ') : 'all people' %>
      </span>
    </form>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-people me-2"></i>People summary</span>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div class="team-kpi">
        <span class="team-kpi-label">Team chargeability</span>
        <span class="team-kpi-value <%= view.chargeability.realClass %>"><%= view.chargeability.real %>%</span>
        <span class="team-kpi-sep">/</span>
        <span class="team-kpi-value <%= view.chargeability.predictedClass %>"><%= view.chargeability.predicted %>%</span>
      </div>
      <span class="text-muted small">real / predicted (incl. soft bookings)</span>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <% view.people.forEach(function(member) { %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card h-100 capacity-card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="fw-semibold"><%= member.person %></div>
                  <% if (member.role) { %><div class="person-role small text-muted"><%= member.role %></div><% } %>
                </div>
                <span class="small text-muted text-nowrap"><%= member.dailyHours %>h/day</span>
              </div>

              <div class="kpi-pair" title="Chargeability = booked hours divided by capacity in the selected window">
                <div class="kpi">
                  <div class="kpi-value <%= member.chargeabilityClass %>"><%= member.chargeabilityReal %>%</div>
                  <div class="kpi-label">Real</div>
                </div>
                <div class="kpi">
                  <div class="kpi-value <%= member.chargeabilityPredictedClass %>"><%= member.chargeabilityPredicted %>%</div>
                  <div class="kpi-label">Predicted</div>
                </div>
              </div>

              <div class="capacity-track" title="<%= member.activeHours %>h committed, <%= member.softHours %>h soft booked">
                <div class="capacity-fill" style="width: <%= member.assignedPercent.toFixed(2) %>%;"></div>
                <div class="capacity-fill-soft" style="width: <%= member.softPercent.toFixed(2) %>%;"></div>
              </div>
              <div class="d-flex justify-content-between small mt-2">
                <span class="text-muted"><%= member.activeHours %>h committed</span>
                <span class="<%= capacityClass(member.availableHours) %>"><%= member.availableHours %>h free</span>
              </div>
              <div class="d-flex justify-content-between small mt-1">
                <span class="soft-hint"><%= member.softHours %>h soft booked</span>
                <span class="text-muted"><%= member.availableIfWonHours %>h if all won</span>
              </div>
              <div class="text-muted small mt-1">Capacity <%= member.capacityHours %>h in window</div>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (!view.people.length) { %>
        <div class="col-12"><div class="alert alert-info mb-0">
          <% if (personFilters.length) { %>
            No people match the current person filter.
          <% } else { %>
            No people configured. Add people in <a href="/settings">Configuration</a>.
          <% } %>
        </div></div>
      <% } %>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Quick assign</div>
  <div class="card-body">
    <form method="post" action="/management/assignments" class="row g-2 align-items-end">
      <div class="col-lg-4 col-md-6">
        <label class="form-label">Opportunity</label>
        <select class="form-select" name="opportunityId" required>
          <option value="">Select opportunity</option>
          <% projects.forEach(function(project) { %>
            <option value="<%= project.Id %>"><%= project.Name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-2 col-md-6">
        <label class="form-label">Person</label>
        <select class="form-select" name="personName" required>
          <option value="">Select person</option>
          <% people.forEach(function(person) { %>
            <option value="<%= person %>"><%= person %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-2 col-md-4 col-6">
        <label class="form-label">Start</label>
        <input type="date" class="form-control" name="plannedStartDate" value="<%= today %>" required>
      </div>
      <div class="col-lg-2 col-md-4 col-6">
        <label class="form-label">End</label>
        <input type="date" class="form-control" name="plannedEndDate" value="<%= today %>" required>
      </div>
      <div class="col-lg-1 col-md-2 col-6">
        <label class="form-label">%</label>
        <input type="number" class="form-control" name="allocationPercent" min="1" max="100" step="1" value="50">
      </div>
      <div class="col-lg-1 col-md-2 col-6">
        <button class="btn btn-primary w-100" type="submit">Assign</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-list-ul me-2"></i>Assignments (<%= view.assignmentRows.length %>)</span>
    <input type="text" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Filter rows..." oninput="filterTable(this, 'assignmentTable')">
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 management-table" id="assignmentTable">
        <thead>
          <tr>
            <th>Person</th>
            <th>Opportunity</th>
            <th>Stage</th>
            <th>Window</th>
            <th class="text-end">Allocation</th>
            <th class="text-end">Hours</th>
            <th class="text-end">Booking</th>
            <th class="text-end">Timeline</th>
          </tr>
        </thead>
        <tbody>
          <% view.assignmentRows.forEach(function(assignment) { %>
            <tr>
              <td class="fw-semibold"><%= assignment.PersonName %></td>
              <td><a href="/opportunities/<%= assignment.OpportunityId %>#assignments"><%= assignment.OpportunityName %></a></td>
              <td><span class="stage-dot <%= stageAccentClass(assignment.Stage) %>"></span><%= assignment.Stage || '-' %> <span class="text-muted small">(<%= stageStatusLabel(assignment.Stage) %>)</span></td>
              <td class="text-nowrap">
                <%= assignment.StartDate || '-' %> &rarr; <%= assignment.EndDate || '-' %>
                <% if (assignment.IsOnHold) { %>
                  <div class="hold-hint small"><i class="bi bi-pause-circle me-1"></i>On hold <%= assignment.HoldStartDate %> &rarr; <%= assignment.HoldEndDate %></div>
                <% } %>
              </td>
              <td class="text-end"><%= assignment.AllocationPercent || 0 %>%</td>
              <td class="text-end"><%= assignment.AllocatedHours %>h</td>
              <td class="text-end">
                <span class="booking-state <%= assignment.IsCommitted ? 'is-committed' : 'is-soft' %>">
                  <%= assignment.IsCommitted ? 'Committed' : 'Soft' %>
                </span>
              </td>
              <td class="text-end">
                <form method="post" action="/management/assignments/<%= assignment.Id %>/visibility">
                  <input type="hidden" name="isTimelineVisible" value="<%= assignment.IsTimelineVisible ? 'false' : 'true' %>">
                  <button class="btn btn-sm <%= assignment.IsTimelineVisible ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit">
                    <%= assignment.IsTimelineVisible ? 'Hide' : 'Show' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!view.assignmentRows.length) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No assignments yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-bar-chart-steps me-2"></i>Timeline</span>
    <div class="timeline-legend d-flex flex-wrap gap-2">
      <%
        // Legend chips toggle a stage in or out of the current multi-selection.
        var baseQuery = 'applied=1&perspective=' + encodeURIComponent(perspective) + '&units=' + encodeURIComponent(unitsToShow);
        function toggleHref(value) {
          var next = stageFilters.indexOf(value) !== -1
            ? stageFilters.filter(function(s) { return s !== value; })
            : stageFilters.concat([value]);
          var qs = baseQuery;
          next.forEach(function(s) { qs += '&stage=' + encodeURIComponent(s); });
          return '/management?' + qs;
        }
      %>
      <a class="legend-chip <%= stageFilters.length === 0 ? 'is-active' : '' %>" href="/management?<%= baseQuery %>">All</a>
      <% stageLegend.forEach(function(item) { %>
        <a class="legend-chip accent-<%= item.key %> <%= stageFilters.indexOf(item.label) !== -1 ? 'is-active' : '' %>"
           href="<%= toggleHref(item.label) %>"
           title="<%= item.meaning %>"><%= item.label %></a>
      <% }) %>
      <a class="legend-chip legend-free <%= stageFilters.indexOf('free') !== -1 ? 'is-active' : '' %>"
         href="<%= toggleHref('free') %>">Free capacity</a>
    </div>
  </div>
  <div class="card-body">
    <div class="timeline-scroll">
      <div class="timeline-grid" id="timelineGrid"
           data-perspective="<%= view.timeline.perspective %>"
           data-range-start="<%= view.timeline.startText %>"
           data-range-end-exclusive="<%= view.timeline.endExclusiveText %>"
           data-window-start="<%= view.timeline.windowStartText %>"
           data-window-end-exclusive="<%= view.timeline.windowEndExclusiveText %>"
           style="--timeline-units: <%= view.timeline.units.length %>;">
        <div class="timeline-head">
          <div class="timeline-person-head">Person</div>
          <div class="timeline-head-stack">
            <div class="timeline-groups" style="--timeline-units: <%= view.timeline.units.length %>;">
              <% view.timeline.unitGroups.forEach(function(group) { %>
                <div class="timeline-group" style="--group-span: <%= group.span %>;"><span><%= group.label %></span></div>
              <% }) %>
            </div>
            <div class="timeline-units" style="--timeline-units: <%= view.timeline.units.length %>;">
              <% view.timeline.units.forEach(function(unit) { %>
                <div class="timeline-unit"><%= unit.label %></div>
              <% }) %>
            </div>
          </div>
        </div>

        <% view.timeline.rows.forEach(function(row) { %>
          <div class="timeline-row" style="height: <%= row.height %>px;">
            <div class="timeline-person"
                 title="<%= row.person %> &middot; <%= row.capacityHours %>h capacity in this window
Committed: <%= row.committedHours %>h
Free: <%= row.freeHours %>h
Committed + free = <%= (row.committedHours + row.freeHours).toFixed(2) %>h
Soft booked on top: <%= row.softHours %>h"><%= row.person %>
              <span class="timeline-person-load"><%= row.committedHours %>h / <%= row.capacityHours %>h</span>
            </div>
            <div class="timeline-lane" style="--timeline-units: <%= view.timeline.units.length %>;">
              <div class="timeline-gridlines">
                <% view.timeline.units.forEach(function(unit) { %><div class="timeline-gridline"></div><% }) %>
              </div>
              <% row.chips.forEach(function(chip) { %>
                <div class="timeline-chip <%= chip.accentClass %> <%= chip.IsCommitted ? 'is-committed' : 'is-soft' %> <%= chip.IsOnHold ? 'is-on-hold' : '' %>"
                     data-assignment-id="<%= chip.Id %>"
                     data-opportunity-id="<%= chip.OpportunityId %>"
                     data-start="<%= chip.StartDate %>"
                     data-end="<%= chip.EndDate %>"
                     data-percent="<%= chip.AllocationPercent || 0 %>"
                     data-hours="<%= chip.AllocatedHours %>"
                     data-initial-hours="<%= chip.InitialAllocatedHours %>"
                     data-initial-percent="<%= chip.InitialPercent %>"
                     data-opportunity-hours="<%= chip.OpportunityHours %>"
                     data-capacity-hours="<%= row.capacityHours %>"
                     data-capacity-percent="<%= chip.capacityPercent %>"
                     data-hold-start="<%= chip.HoldStartDate || '' %>"
                     data-hold-end="<%= chip.HoldEndDate || '' %>"
                     data-stage-label="<%= stageStatusLabel(chip.Stage) %>"
                     data-person="<%= chip.PersonName %>"
                     style="left: <%= chip.geometry.left.toFixed(3) %>%; width: <%= chip.geometry.width.toFixed(3) %>%; top: <%= chip.geometry.top %>px;"
                     title="<%= chip.OpportunityName %> &middot; <%= chip.PersonName %>
<%= chip.StartDate %> &rarr; <%= chip.EndDate %> (<%= chip.businessDays %> working days)
Assigned: <%= chip.InitialAllocatedHours %>h = <%= chip.InitialPercent %>% of the <%= chip.OpportunityHours %>h project
Now on the bar: <%= chip.AllocatedHours %>h<%= chip.IsResized ? ' (resized)' : '' %>
In this window: <%= chip.windowHours %>h = <%= chip.capacityPercent %>% of <%= row.person %>'s <%= row.capacityHours %>h capacity<%= chip.IsCommitted ? '' : '\nSoft booking: does not consume capacity yet' %>">
                  <span class="timeline-chip-resizer start" data-edge="start" title="Drag to change the start date"></span>
                  <% if (chip.hold) { %>
                    <span class="timeline-chip-hold"
                          style="left: <%= chip.hold.left.toFixed(3) %>%; width: <%= chip.hold.width.toFixed(3) %>%;"
                          title="On hold <%= chip.HoldStartDate %> &rarr; <%= chip.HoldEndDate %> (capacity free)"></span>
                  <% } %>
                  <a class="timeline-chip-body" href="/opportunities/<%= chip.OpportunityId %>#assignments">
                    <span class="timeline-chip-title">
                      <% if (chip.IsOnHold) { %><i class="bi bi-pause-circle me-1"></i><% } %><% if (!chip.IsCommitted) { %><i class="bi bi-hourglass-split me-1"></i><% } %><%= chip.OpportunityName %>
                    </span>
                    <span class="timeline-chip-meta" data-role="meta"><%
                      %><%= chip.InitialAllocatedHours %>h<%
                      %><% if (chip.IsResized) { %> &rarr; <%= chip.AllocatedHours %>h<% } %><%
                      %> &middot; <%= chip.capacityPercent %>% cap<%
                      %> &middot; <%= stageStatusLabel(chip.Stage) %></span>
                  </a>
                  <span class="timeline-chip-resizer end" data-edge="end" title="Drag to change the end date"></span>
                </div>
              <% }) %>
              <% row.freeChips.forEach(function(segment) { %>
                <div class="timeline-free"
                     style="left: <%= segment.geometry.left.toFixed(3) %>%; width: <%= segment.geometry.width.toFixed(3) %>%; top: <%= segment.geometry.top %>px;"
                     title="<%= segment.groupLabel %> <%= segment.unitLabel %>: <%= segment.freeHours %>h free of <%= segment.capacityHours %>h<%= segment.softHours ? ' (' + segment.softHours + 'h soft booked)' : '' %>">
                  <span class="timeline-free-label">
                    <%= segment.unitLabel %> &middot; <%= segment.freeHours %>h free<% if (segment.softHours) { %> &middot; <%= segment.softHours %>h soft<% } %>
                  </span>
                </div>
              <% }) %>
              <% if (!row.chips.length && !row.freeChips.length) { %>
                <div class="timeline-empty">No scheduled work in this window</div>
              <% } %>
            </div>
          </div>
        <% }) %>

        <% if (!view.timeline.rows.length) { %>
          <div class="p-4 text-center text-muted">Nothing to display for the selected filters.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="/js/timeline.js"></script>
<%- include('partials/footer') %>
