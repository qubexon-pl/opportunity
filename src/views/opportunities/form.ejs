<% if (!partial) { %><%- include('../partials/header') %><% } %>
<%
  var isNew = mode === 'new';
  var o = opportunity;
  var notesList = typeof notes !== 'undefined' ? notes : [];
  var stepsList = typeof nextSteps !== 'undefined' ? nextSteps : [];
  var assignmentList = typeof assignments !== 'undefined' ? assignments : [];
  var absence = typeof absenceImpact !== 'undefined' && absenceImpact ? absenceImpact : null;
  var todayText = typeof today !== 'undefined' ? today : toDateText(new Date());
  var actionUrl = isNew ? '/opportunities' : '/opportunities/' + o.Id;
%>

<div id="opportunityDetail">
<div class="page-hero">
  <div>
    <h2>
      <i class="bi <%= isNew ? 'bi-plus-circle' : 'bi-briefcase' %> me-2" aria-hidden="true"></i>
      <%= isNew ? 'Create opportunity' : o.Name %>
    </h2>
    <p class="text-muted mb-0">
      <%= isNew ? 'Add a new opportunity to the pipeline.' : (o.TechnologyStack || 'No technology stack') %>
      <% if (!isNew && o.OppId) { %><span class="ms-2 badge text-bg-secondary"><%= o.OppId %></span><% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</a>
    <% if (!isNew) { %>
      <form method="post" action="/opportunities/<%= o.Id %>/delete" data-confirm="Delete this opportunity and all of its notes, steps, and assignments?" data-confirm-title="Delete opportunity">
        <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
      </form>
    <% } %>
  </div>
</div>

<% if (!isNew) { %>
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100 stat-card"><div class="card-body py-3">
        <div class="summary-label">Stage</div>
        <div class="fs-5 fw-bold"><%= o.Stage || '-' %></div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100 stat-card"><div class="card-body py-3">
        <div class="summary-label">Status</div>
        <div class="fs-5 fw-bold"><%= o.Status || '-' %></div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100 stat-card"><div class="card-body py-3">
        <div class="summary-label">Opportunity hours</div>
        <div class="fs-5 fw-bold"><%= o.OpportunityHours == null ? 0 : o.OpportunityHours %>h</div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100 stat-card"><div class="card-body py-3">
        <div class="summary-label">Assignments</div>
        <div class="fs-5 fw-bold"><%= assignmentList.length %></div>
      </div></div>
    </div>
  </div>
<% } %>

<% if (!isNew) { %>
  <%
    var openSteps = stepsList.filter(function(step) { return !step.IsDone; }).length;
  %>
  <ul class="nav nav-tabs mb-3 opportunity-tabs" id="opportunityTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#paneOverview" data-tab-key="overview" type="button" role="tab" aria-controls="paneOverview" aria-selected="true">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Overview
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-assignments" data-bs-toggle="tab" data-bs-target="#paneAssignments" data-tab-key="assignments" type="button" role="tab" aria-controls="paneAssignments" aria-selected="false">
        <i class="bi bi-people me-1" aria-hidden="true"></i>Assignments <span class="badge rounded-pill text-bg-light"><%= assignmentList.length %></span>
        <% if (absence && absence.items.length) { %><i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Planned absence affects this timeline" aria-hidden="true"></i><span class="visually-hidden">(planned absence affects this timeline)</span><% } %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-activity" data-bs-toggle="tab" data-bs-target="#paneActivity" data-tab-key="activity" type="button" role="tab" aria-controls="paneActivity" aria-selected="false">
        <i class="bi bi-journal-check me-1" aria-hidden="true"></i>Notes and next steps <span class="badge rounded-pill text-bg-light"><%= openSteps %> open</span>
      </button>
    </li>
  </ul>
<% } %>

<div class="<%= isNew ? '' : 'tab-content' %>">
<div class="<%= isNew ? '' : 'tab-pane fade show active' %>" id="paneOverview" role="<%= isNew ? 'region' : 'tabpanel' %>" aria-labelledby="tab-overview">
<form method="post" action="<%= actionUrl %>" id="opportunityForm" data-track-changes>
  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header">
          <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseBasic" aria-expanded="true">
            <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-info-circle me-2" aria-hidden="true"></i>Basic information</span>
          </button>
        </div>
        <div class="card-body row g-3 collapse show" id="collapseBasic">
          <div class="col-12">
            <label class="form-label" for="name">Opportunity name</label>
            <input class="form-control" id="name" name="name" required maxlength="200" value="<%= o.Name || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="oppId">OPP ID</label>
            <input class="form-control" id="oppId" name="oppId" maxlength="50" placeholder="External ID" value="<%= o.OppId || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="technologyStack">Technology stack</label>
            <input class="form-control" id="technologyStack" name="technologyStack" maxlength="400" value="<%= o.TechnologyStack || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" maxlength="4000" placeholder="Describe the opportunity..."><%= o.Description || '' %></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="techOwner">Lead consultant</label>
            <select class="form-select" id="techOwner" name="techOwner">
              <option value="">Select person</option>
              <% people.forEach(function(person) { %>
                <option value="<%= person %>" <%= (o.TechOwner || '') === person ? 'selected' : '' %>><%= person %></option>
              <% }) %>
              <% if (o.TechOwner && people.indexOf(o.TechOwner) === -1) { %>
                <option value="<%= o.TechOwner %>" selected><%= o.TechOwner %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="businessOwner">Business owner</label>
            <input class="form-control" id="businessOwner" name="businessOwner" maxlength="200" value="<%= o.BusinessOwner || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="firstContactDate">First contact date</label>
            <input type="date" class="form-control" id="firstContactDate" name="firstContactDate" value="<%= toDateText(o.FirstContactDate) %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="tags">Tags</label>
            <input class="form-control" id="tags" name="tags" maxlength="400" placeholder="comma separated" value="<%= o.Tags || '' %>">
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header">
          <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapsePlanning" aria-expanded="true">
            <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-calendar3 me-2" aria-hidden="true"></i>Planning and capacity</span>
          </button>
        </div>
        <div class="card-body row g-3 collapse show" id="collapsePlanning">
          <div class="col-md-4">
            <label class="form-label" for="stage">Stage</label>
            <select class="form-select" id="stage" name="stage">
              <% stages.forEach(function(stage) { %>
                <option value="<%= stage %>" <%= (o.Stage || 'New') === stage ? 'selected' : '' %>><%= stage %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
              <% statuses.forEach(function(status) { %>
                <option value="<%= status %>" <%= (o.Status || 'Open') === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="priority">Priority</label>
            <select class="form-select" id="priority" name="priority">
              <% [1,2,3,4,5].forEach(function(priority) { %>
                <option value="<%= priority %>" <%= Number(o.Priority || 3) === priority ? 'selected' : '' %>><%= priority %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label" for="bookingMode">Capacity booking</label>
            <select class="form-select" id="bookingMode" name="bookingMode">
              <% bookingModes.forEach(function(option) { %>
                <option value="<%= option.key %>" <%= bookingMode(o) === option.key ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
            <div class="form-text">
              Currently: <strong><%= bookingLabel(o) %></strong>.
              Committed stages: <%= firmStages.length ? firmStages.join(', ') : 'none' %>.
              Soft bookings appear on the timeline but do not reduce available capacity.
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label" for="opportunityHours">Opportunity hours</label>
            <input type="number" class="form-control" id="opportunityHours" name="opportunityHours" min="0" step="0.5" required placeholder="e.g. 120" value="<%= o.OpportunityHours == null ? '' : o.OpportunityHours %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="opportunityTimeline">Opportunity timeline (weeks)</label>
            <input class="form-control" id="opportunityTimeline" name="opportunityTimeline" maxlength="100" placeholder="e.g. 4 weeks" value="<%= o.OpportunityTimeline || '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="plannedStartDate">Planned start</label>
            <input type="date" class="form-control" id="plannedStartDate" name="plannedStartDate" value="<%= toDateText(o.PlannedStartDate) %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="plannedEndDate">Planned end</label>
            <input type="date" class="form-control" id="plannedEndDate" name="plannedEndDate" value="<%= toDateText(o.PlannedEndDate) %>">
          </div>
          <div class="col-12 small text-muted">
            Calculated end date from hours: <strong id="plannedEndPreview"><%= plannedEndPreview || 'set start date and hours' %></strong>
            <span class="ms-2">Estimated duration: <strong id="plannedDurationPreview"><%= plannedDurationPreview || '-' %></strong> working days</span>
          </div>
          <%# Next steps are managed in their own card; these carry the stored legacy values through a save. %>
          <input type="hidden" name="nextStepSummary" value="<%= o.NextStepSummary || '' %>">
          <input type="hidden" name="nextStepDueDate" value="<%= toDateText(o.NextStepDueDate) %>">
        </div>
      </div>
    </div>
  </div>
</form>
</div><!-- /#paneOverview -->

<% if (!isNew) { %>
<div class="tab-pane fade" id="paneAssignments" role="tabpanel" aria-labelledby="tab-assignments">
  <% if (absence && absence.items.length) { %>
    <div class="card mb-4 absence-impact-card <%= absence.shiftsPlannedEnd || absence.blocksDelivery ? 'is-at-risk' : '' %>" id="absence-impact">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseAbsence" aria-expanded="true">
          <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-calendar-x me-2" aria-hidden="true"></i>Planned absence affecting this timeline</span>
        </button>
        <span class="badge <%= absence.shiftsPlannedEnd || absence.blocksDelivery ? 'text-bg-danger' : 'text-bg-warning' %>">
          <%= absence.daysLost %> working <%= absence.daysLost === 1 ? 'day' : 'days' %> lost &middot; <%= absence.hoursAtRisk %>h at risk
        </span>
      </div>
      <div class="card-body collapse show" id="collapseAbsence">
        <p class="text-muted small">
          <%= absence.peopleAffected.length === 1 ? absence.peopleAffected[0] + ' is' : absence.peopleAffected.length + ' people are' %>
          away on days this project was counting on.
          The allocation still owes its hours, so either the window stretches or the hours move to someone else.
          <% if (absence.scopeHours > 0) { %>
            That is <strong><%= absence.percentOfScope %>%</strong> of the <%= absence.scopeHours %>h project scope.
          <% } %>
        </p>

        <% if (absence.blocksDelivery) { %>
          <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-octagon me-1" aria-hidden="true"></i>
            At least one allocation has no working days left at all once absence is taken out &mdash; it cannot deliver in its current window.
          </div>
        <% } else if (absence.shiftsPlannedEnd) { %>
          <div class="alert alert-warning py-2 small mb-3">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
            Recovering the lost days runs past the planned end of <strong><%= absence.plannedEndDate %></strong>,
            to <strong><%= absence.latestSuggestedEnd %></strong>.
          </div>
        <% } %>

        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0 absence-impact-table">
            <thead>
              <tr>
                <th>Person</th>
                <th>Allocation window</th>
                <th class="text-end">Working days</th>
                <th class="text-end">Hours at risk</th>
                <th>Absence</th>
                <th>To recover</th>
              </tr>
            </thead>
            <tbody>
              <% absence.items.forEach(function(item) { %>
                <tr class="<%= item.blocksDelivery ? 'table-danger' : '' %>">
                  <td class="fw-semibold"><%= item.person %></td>
                  <td class="text-nowrap"><%= item.startDate %> &rarr; <%= item.endDate %></td>
                  <td class="text-end">
                    <%= item.workingDays %> of <%= item.businessDays %>
                    <div class="absence-hint small">&minus;<%= item.absentDays %>d away</div>
                  </td>
                  <td class="text-end">
                    <strong><%= item.hoursAtRisk %>h</strong> of <%= item.allocatedHours %>h
                    <div class="text-muted small"><%= item.percentOfAssignment %>% of the allocation</div>
                  </td>
                  <td class="small">
                    <% item.absences.forEach(function(a) { %>
                      <div><span class="absence-kind"><%= a.kind %></span> <%= a.startDate %> &rarr; <%= a.endDate %> <span class="text-muted">(<%= a.daysInWindow %>d here)</span></div>
                    <% }) %>
                  </td>
                  <td class="small text-nowrap">
                    <% if (item.blocksDelivery) { %>
                      <span class="text-danger">Reschedule &mdash; no working days left</span>
                    <% } else { %>
                      End <%= item.suggestedEndDate %>
                      <div class="text-muted">+<%= item.absentDays %> working <%= item.absentDays === 1 ? 'day' : 'days' %></div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="text-muted small mb-0 mt-3">
          Absence is recorded per person in <a href="/settings">Configuration</a>. Nothing here has been changed automatically.
        </p>
      </div>
    </div>
  <% } %>

  <div class="card" id="assignments">
    <div class="card-header">
      <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseAssignments" aria-expanded="true">
        <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-people me-2" aria-hidden="true"></i>Assignments for timeline</span>
      </button>
    </div>
    <div class="card-body collapse show" id="collapseAssignments">
      <form method="post" action="/opportunities/<%= o.Id %>/assignments" class="allocation-form row g-2 align-items-end mb-4"
            data-opportunity-hours="<%= o.OpportunityHours || 0 %>">
        <div class="col-lg-3 col-md-6">
          <label class="form-label">Person</label>
          <select aria-label="Person" class="form-select" name="personName" data-role="person" required>
            <option value="">Select person</option>
            <% people.forEach(function(person) { %>
              <option value="<%= person %>" <%= (o.TechOwner || '') === person ? 'selected' : '' %>><%= person %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
          <label class="form-label">Start date</label>
          <input aria-label="Start date" type="date" class="form-control" name="plannedStartDate" data-role="start" required value="<%= toDateText(o.PlannedStartDate) || todayText %>">
        </div>
        <div class="col-lg-2 col-md-3 col-6">
          <label class="form-label">End date</label>
          <input aria-label="End date" type="date" class="form-control" name="plannedEndDate" data-role="end" required value="<%= toDateText(o.PlannedEndDate) || todayText %>">
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <label class="form-label">Allocation mode</label>
          <select aria-label="Allocation mode" class="form-select" name="allocationMode" data-role="mode">
            <option value="percent">Percent of total hours</option>
            <option value="total-hours">Total hours for period</option>
            <option value="monthly-hours">Hours per month</option>
          </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <label class="form-label" data-role="value-label">Allocation %</label>
          <input aria-label="Allocation %" type="number" class="form-control" data-role="value" min="0.5" step="0.5" value="50">
        </div>
        <div class="col-lg-1 col-md-4 col-12">
          <button class="btn btn-primary w-100" type="submit">Add</button>
        </div>
        <div class="col-12">
          <div class="allocation-preview" data-role="preview">&nbsp;</div>
        </div>
        <input type="hidden" name="allocationPercent" data-role="percent-field">
        <input type="hidden" name="allocatedHours" data-role="hours-field">
      </form>

      <% assignmentList.forEach(function(assignment) { %>
        <%
          var formId = 'assignment-form-' + assignment.Id;
          var startText = toDateText(assignment.PlannedStartDate);
          var endText = toDateText(assignment.PlannedEndDate);
          var onHold = isCurrentlyOnHold(parseHolds(assignment.Holds));
          var allocationModes = ['percent', 'total-hours', 'monthly-hours'];
          var allocationMode = allocationModes.indexOf(assignment.AllocationMode) === -1 ? 'percent' : assignment.AllocationMode;
          var oppHours = Number(o.OpportunityHours || 0);
          var currentHours = round2(assignment.AllocatedHours || 0);
          // Legacy rows have no stored initial figure; fall back to their share of the project.
          var initialHours = Number(assignment.InitialAllocatedHours) > 0
            ? round2(assignment.InitialAllocatedHours)
            : round2(oppHours * (Number(assignment.AllocationPercent || 0) / 100)) || currentHours;
          var initialPercent = oppHours > 0 ? round2((initialHours / oppHours) * 100) : 0;
          var wasResized = Math.abs(currentHours - initialHours) >= 0.01;
          // The form edits the live allocation, so re-saving without changes is a no-op
          // rather than a silent reset of a resize. Saving re-baselines the initial figure.
          var formPercent = oppHours > 0 ? round2((currentHours / oppHours) * 100) : initialPercent;
        %>
        <div class="assignment-card <%= onHold ? 'is-on-hold' : '' %>">
          <div class="assignment-card-head">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="assignment-person"><%= assignment.PersonName %></span>
              <% if (onHold) { %>
                <span class="badge text-bg-info"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>On hold</span>
              <% } %>
              <% if (!assignment.IsTimelineVisible) { %>
                <span class="badge text-bg-light"><i class="bi bi-eye-slash me-1" aria-hidden="true"></i>Hidden</span>
              <% } %>
            </div>
            <div class="assignment-facts">
              <span title="The allocation as it was defined, and what that is worth against the <%= oppHours %>h project total">
                <strong><%= initialHours %>h</strong> assigned &middot; <%= initialPercent %>% of project
              </span>
              <% if (wasResized) { %>
                <span class="assignment-fact-resized" title="The bar was broadened or squeezed on the timeline, which rescaled the real hours">
                  <i class="bi bi-arrows-expand me-1" aria-hidden="true"></i><strong><%= currentHours %>h</strong> after resize
                </span>
              <% } %>
              <span class="text-nowrap"><%= startText || '-' %> &rarr; <%= endText || '-' %></span>
            </div>
          </div>



          <%# Kept outside the edit form; the buttons reach them via the form attribute. %>
          <form method="post" id="stretch-minus-<%= assignment.Id %>" class="d-none" action="/opportunities/<%= o.Id %>/assignments/<%= assignment.Id %>/stretch">
            <input type="hidden" name="days" value="-7">
            <input type="hidden" name="plannedStartDate" value="<%= startText %>">
            <input type="hidden" name="plannedEndDate" value="<%= endText %>">
          </form>
          <form method="post" id="stretch-plus-<%= assignment.Id %>" class="d-none" action="/opportunities/<%= o.Id %>/assignments/<%= assignment.Id %>/stretch">
            <input type="hidden" name="days" value="7">
            <input type="hidden" name="plannedStartDate" value="<%= startText %>">
            <input type="hidden" name="plannedEndDate" value="<%= endText %>">
          </form>
          <form method="post" id="assignment-delete-<%= assignment.Id %>" class="d-none"
                action="/opportunities/<%= o.Id %>/assignments/<%= assignment.Id %>/delete"
                data-confirm="Delete this assignment?" data-confirm-title="Delete assignment"></form>

          <div class="assignment-toolbar">
            <button class="btn btn-sm btn-outline-secondary" type="submit" form="stretch-minus-<%= assignment.Id %>" title="Shorten the window by a week">
              <i class="bi bi-dash-lg" aria-hidden="true"></i> 7d
            </button>
            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#assignment-edit-<%= assignment.Id %>" aria-expanded="false" aria-controls="assignment-edit-<%= assignment.Id %>">
              <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
            </button>
            <button class="btn btn-sm btn-outline-secondary" type="submit" form="stretch-plus-<%= assignment.Id %>" title="Extend the window by a week">
              <i class="bi bi-plus-lg" aria-hidden="true"></i> 7d
            </button>
            <button class="btn btn-sm btn-outline-danger" type="submit" form="assignment-delete-<%= assignment.Id %>">
              <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
            </button>
          </div>
          <%# Editing is folded away: the card shows the facts, Edit opens the form. %>
          <div class="collapse assignment-edit" id="assignment-edit-<%= assignment.Id %>">
          <form method="post" id="<%= formId %>"
                action="/opportunities/<%= o.Id %>/assignments/<%= assignment.Id %>"
                class="allocation-form assignment-edit-form"
                data-opportunity-hours="<%= o.OpportunityHours || 0 %>"
                data-allocated-hours="<%= currentHours %>"
                data-allocation-percent="<%= formPercent %>">
            <div class="assignment-group">
              <div class="assignment-group-title"><i class="bi bi-calendar-range me-1" aria-hidden="true"></i>Schedule</div>
              <div class="row g-2">
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Person</label>
                  <select aria-label="Person" class="form-select form-select-sm" name="personName" data-role="person">
                    <% people.forEach(function(person) { %>
                      <option value="<%= person %>" <%= assignment.PersonName === person ? 'selected' : '' %>><%= person %></option>
                    <% }) %>
                    <% if (assignment.PersonName && people.indexOf(assignment.PersonName) === -1) { %>
                      <option value="<%= assignment.PersonName %>" selected><%= assignment.PersonName %></option>
                    <% } %>
                  </select>
                </div>
                <div class="col-lg-4 col-md-3 col-6">
                  <label class="form-label small">Start date</label>
                  <input aria-label="Start date" type="date" class="form-control form-control-sm" name="plannedStartDate" data-role="start" value="<%= startText %>">
                </div>
                <div class="col-lg-4 col-md-3 col-6">
                  <label class="form-label small">End date</label>
                  <input aria-label="End date" type="date" class="form-control form-control-sm" name="plannedEndDate" data-role="end" value="<%= endText %>">
                </div>
              </div>
            </div>

            <div class="assignment-group">
              <div class="assignment-group-title"><i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>Allocation</div>
              <div class="row g-2">
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Allocation mode</label>
                  <select aria-label="Allocation mode" class="form-select form-select-sm" name="allocationMode" data-role="mode">
                    <option value="percent" <%= allocationMode === 'percent' ? 'selected' : '' %>>Percent of total hours</option>
                    <option value="total-hours" <%= allocationMode === 'total-hours' ? 'selected' : '' %>>Total hours for period</option>
                    <option value="monthly-hours" <%= allocationMode === 'monthly-hours' ? 'selected' : '' %>>Hours per month</option>
                  </select>
                </div>
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small" data-role="value-label">Allocation %</label>
                  <input aria-label="Allocation %" type="number" class="form-control form-control-sm" data-role="value" min="0.5" step="0.5" value="<%= formPercent %>" title="<%= wasResized ? 'This reflects the ' + currentHours + 'h currently on the timeline. Saving makes it the new agreed allocation.' : 'Share of the ' + oppHours + 'h project total' %>">
                </div>
                <div class="col-lg-4 d-flex align-items-end">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="visible-<%= assignment.Id %>" name="isTimelineVisible" <%= assignment.IsTimelineVisible ? 'checked' : '' %>>
                    <label class="form-check-label small" for="visible-<%= assignment.Id %>">Visible on timeline</label>
                  </div>
                </div>
                <div class="col-12">
                  <div class="allocation-preview" data-role="preview">&nbsp;</div>
                </div>
              </div>
            </div>

            <div class="assignment-group" data-role="hold-group">
              <div class="assignment-group-title"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>Hold periods &mdash; frees capacity for each period</div>
              <div class="hold-periods" data-role="hold-periods">
                <% parseHolds(assignment.Holds).forEach(function(hold, idx) { %>
                  <div class="hold-period-row row g-2 mb-1" data-role="hold-row">
                    <div class="col-lg-4 col-md-5 col-5">
                      <label class="form-label small">Hold from</label>
                      <input aria-label="Hold from" type="date" class="form-control form-control-sm" name="holdStartDate" value="<%= hold.startDate %>">
                    </div>
                    <div class="col-lg-4 col-md-5 col-5">
                      <label class="form-label small">Hold until</label>
                      <div class="input-group input-group-sm">
                        <input aria-label="Hold until" type="date" class="form-control form-control-sm rounded" name="holdEndDate" value="<%= hold.endDate %>">
                        <button type="button" class="btn btn-outline-danger rounded-end px-2" data-role="remove-hold" title="Remove this hold period">
                          <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }) %>
                <% if (!parseHolds(assignment.Holds).length) { %>
                  <div class="hold-period-row row g-2 mb-1" data-role="hold-row">
                    <div class="col-lg-4 col-md-5 col-5">
                      <label class="form-label small">Hold from</label>
                      <input aria-label="Hold from" type="date" class="form-control form-control-sm" name="holdStartDate" value="">
                    </div>
                    <div class="col-lg-4 col-md-5 col-5">
                      <label class="form-label small">Hold until</label>
                      <div class="input-group input-group-sm">
                        <input aria-label="Hold until" type="date" class="form-control form-control-sm rounded" name="holdEndDate" value="">
                        <button type="button" class="btn btn-outline-danger rounded-end px-2" data-role="remove-hold" title="Remove this hold period">
                          <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
              <button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-role="add-hold">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Add hold period
              </button>
              <div class="form-text">Leave both empty for no hold. Assigned hours stay unchanged.</div>
            </div>

            <input type="hidden" name="allocationPercent" data-role="percent-field">
            <input type="hidden" name="allocatedHours" data-role="hours-field">
          </form>
            <div class="assignment-edit-actions">
              <button class="btn btn-primary btn-sm" type="submit" form="<%= formId %>">
                <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save assignment
              </button>
              <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#assignment-edit-<%= assignment.Id %>">Cancel</button>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (!assignmentList.length) { %>
        <p class="text-muted small mb-0">No assignments yet. Add at least one person for timeline planning.</p>
      <% } %>
    </div>
  </div>

</div><!-- /#paneAssignments -->

<div class="tab-pane fade" id="paneActivity" role="tabpanel" aria-labelledby="tab-activity">
  <div class="row g-3">
    <div class="col-lg-6" id="notes">
      <div class="card h-100">
        <div class="card-header">
          <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseNotes" aria-expanded="true">
            <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-journal-text me-2" aria-hidden="true"></i>Notes</span>
          </button>
        </div>
        <div class="card-body collapse show" id="collapseNotes">
          <form method="post" action="/opportunities/<%= o.Id %>/notes" class="row g-2 mb-3">
            <div class="col-4">
              <input type="date" class="form-control" name="noteDate" value="<%= todayText %>" required>
            </div>
            <div class="col-6">
              <input class="form-control" name="content" placeholder="Add a note..." required>
            </div>
            <div class="col-2">
              <button class="btn btn-primary w-100" type="submit">Add</button>
            </div>
          </form>

          <% notesList.forEach(function(note) { %>
            <div class="note-item">
              <div class="d-flex justify-content-between align-items-start">
                <small class="text-muted"><%= toDateText(note.NoteDate) %></small>
                <form method="post" action="/opportunities/<%= o.Id %>/notes/<%= note.Id %>/delete" data-confirm="Delete this note?" data-confirm-title="Delete note">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </div>
              <div class="mt-2 pre-wrap"><%= note.Content %></div>
            </div>
          <% }) %>
          <% if (!notesList.length) { %>
            <p class="text-muted small mb-0">No notes yet.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-6" id="steps">
      <div class="card h-100">
        <div class="card-header">
          <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseSteps" aria-expanded="true">
            <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-check2-square me-2" aria-hidden="true"></i>Next steps</span>
          </button>
        </div>
        <div class="card-body collapse show" id="collapseSteps">
          <form method="post" action="/opportunities/<%= o.Id %>/steps" class="row g-2 mb-3">
            <div class="col-7">
              <input class="form-control" name="title" placeholder="Next step..." required maxlength="250">
            </div>
            <div class="col-3">
              <input type="date" class="form-control" name="dueDate">
            </div>
            <div class="col-2">
              <button class="btn btn-primary w-100" type="submit">Add</button>
            </div>
          </form>

          <% stepsList.forEach(function(step) { %>
            <div class="note-item d-flex justify-content-between align-items-start">
              <div class="d-flex gap-2">
                <form method="post" action="/opportunities/<%= o.Id %>/steps/<%= step.Id %>/toggle">
                  <input type="hidden" name="isDone" value="<%= step.IsDone ? 'false' : 'true' %>">
                  <button class="btn btn-sm btn-link p-0" type="submit" title="Toggle done">
                    <i class="bi <%= step.IsDone ? 'bi-check-square-fill text-success' : 'bi-square' %>" aria-hidden="true"></i>
                  </button>
                </form>
                <div>
                  <div class="fw-semibold <%= step.IsDone ? 'text-decoration-line-through text-muted' : '' %>"><%= step.Title %></div>
                  <small class="text-muted">Due: <%= toDateText(step.DueDate) || '-' %></small>
                </div>
              </div>
              <form method="post" action="/opportunities/<%= o.Id %>/steps/<%= step.Id %>/delete" data-confirm="Delete this step?" data-confirm-title="Delete next step">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
              </form>
            </div>
          <% }) %>
          <% if (!stepsList.length) { %>
            <p class="text-muted small mb-0">No next steps yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div><!-- /#paneActivity -->
<% } %>
</div><!-- /.tab-content -->

<%# Save stays in reach wherever the reader is on the page. %>
<div class="sticky-save-bar" data-save-bar>
  <span class="sticky-save-status" data-save-status aria-live="polite"><%= isNew ? 'New opportunity' : 'All changes saved' %></span>
  <span class="text-muted small d-none d-md-inline">Ctrl+S to save</span>
  <button class="btn btn-primary" type="submit" form="opportunityForm">
    <i class="bi bi-check-lg me-1" aria-hidden="true"></i><%= isNew ? 'Create opportunity' : 'Save changes' %>
  </button>
</div>

<script type="application/json" id="peopleDailyHoursData"><%- JSON.stringify((typeof peopleDailyHours !== 'undefined' && peopleDailyHours) || {}).replace(/</g, '\\u003c') %></script>
</div><!-- /#opportunityDetail -->
<% if (!partial) { %><%- include('../partials/footer', { pageScripts: ['/js/allocation.js', '/js/hold-periods.js', '/js/opportunity-form-dynamic.js'] }) %><% } %>
