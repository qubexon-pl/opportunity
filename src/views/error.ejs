<%- include('partials/header') %>
<div class="row">
  <div class="col-lg-6 mx-auto text-center py-5">
    <i class="bi bi-exclamation-triangle display-1 text-danger" aria-hidden="true"></i>
    <h2 class="mt-3"><%= typeof title !== 'undefined' && title ? title : 'Error' %></h2>
    <p class="text-muted"><%= message || 'An unexpected error occurred.' %></p>
    <% if (typeof reference !== 'undefined' && reference) { %>
      <p class="text-muted small">Reference: <code><%= reference %></code></p>
    <% } %>
    <a href="/" class="btn btn-primary mt-3"><i class="bi bi-house me-1" aria-hidden="true"></i>Back to Pipeline</a>
  </div>
</div>
<%- include('partials/footer') %>
