<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark' : 'light' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Opportunities</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<%
  var pagePath = typeof currentPath !== 'undefined' ? currentPath : '';
  var breadcrumbItems = typeof breadcrumb !== 'undefined' ? breadcrumb : [];
  var user = typeof currentUser !== 'undefined' ? currentUser : null;
%>

<div class="app-layout">
  <!-- Sidebar backdrop (mobile) -->
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="appSidebar">
    <a href="/" class="sidebar-brand">
      <span class="brand-logo">O</span>
      <span class="brand-text">Opportunities<small>Business Development</small></span>
    </a>

    <nav class="sidebar-nav">
      <p class="nav-section-title">Main</p>
      <a href="/" class="sidebar-link <%= pagePath === '/' ? 'active' : '' %>" title="Pipeline">
        <i class="bi bi-list-task"></i> <span>Pipeline</span>
      </a>
      <a href="/management" class="sidebar-link <%= pagePath.startsWith('/management') ? 'active' : '' %>" title="Management">
        <i class="bi bi-bar-chart-steps"></i> <span>Management</span>
      </a>

      <p class="nav-section-title">Operations</p>
      <a href="/opportunities/new" class="sidebar-link <%= pagePath === '/opportunities/new' ? 'active' : '' %>" title="New opportunity">
        <i class="bi bi-plus-circle"></i> <span>New opportunity</span>
      </a>

      <p class="nav-section-title">Settings</p>
      <a href="/settings" class="sidebar-link <%= pagePath.startsWith('/settings') ? 'active' : '' %>" title="Configuration">
        <i class="bi bi-gear"></i> <span>Configuration</span>
      </a>

      <!-- Collapse toggle -->
      <a href="#" class="sidebar-link mt-2" onclick="collapseSidebar(event)" title="Collapse sidebar" id="collapseLink">
        <i class="bi bi-layout-sidebar-inset" id="collapseIcon"></i> <span>Collapse</span>
      </a>
    </nav>

    <!-- Sidebar footer: user info -->
    <div class="sidebar-footer">
      <% if (user) { %>
        <div class="sidebar-user">
          <div class="sidebar-user-avatar"><%= (user.name || 'U').charAt(0).toUpperCase() %></div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name"><%= user.name %></div>
            <div class="sidebar-user-email"><%= user.email || '' %></div>
          </div>
        </div>
      <% } else { %>
        <div class="sidebar-user">
          <div class="sidebar-user-avatar">O</div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name">Local workspace</div>
            <div class="sidebar-user-email">Not signed in</div>
          </div>
        </div>
      <% } %>
    </div>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <button class="btn btn-sm mobile-toggle" onclick="toggleSidebar()" style="border:1px solid var(--color-border);width:34px;height:34px;display:none;">
        <i class="bi bi-list"></i>
      </button>

      <!-- Breadcrumb -->
      <nav class="topbar-breadcrumb">
        <a href="/"><i class="bi bi-house-fill"></i></a>
        <% if (breadcrumbItems.length) { %>
          <% breadcrumbItems.forEach(function(item, idx) { %>
            <span class="separator">/</span>
            <% if (idx === breadcrumbItems.length - 1) { %>
              <span class="current"><%= item.label %></span>
            <% } else { %>
              <a href="<%= item.href %>"><%= item.label %></a>
            <% } %>
          <% }) %>
        <% } %>
      </nav>

      <!-- Top bar actions -->
      <div class="topbar-actions">
        <a href="/opportunities/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New opportunity</a>
        <span class="topbar-timestamp" id="lastRefreshed"></span>
        <button class="btn-density-toggle" onclick="toggleDensity()" title="Toggle compact/comfortable view (Ctrl+D)">
          <i class="bi bi-distribute-vertical" id="densityIcon"></i>
        </button>
        <button class="btn-theme-toggle" onclick="toggleTheme()" title="Toggle dark/light mode (Ctrl+Shift+D)">
          <i class="bi bi-moon" id="themeIcon"></i>
        </button>
      </div>
    </header>

    <!-- Page content -->
    <div class="page-content">

      <% (typeof flashSuccess !== 'undefined' ? flashSuccess : []).forEach(function(message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss>
          <i class="bi bi-check-circle me-2"></i><%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
      <% (typeof flashError !== 'undefined' ? flashError : []).forEach(function(message) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle me-2"></i><%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>

<script>
function goBackOr(fallbackUrl) {
  if (document.referrer && document.referrer !== window.location.href) {
    window.history.back();
    return;
  }
  window.location.href = fallbackUrl || '/';
}

function toggleSidebar() {
  document.getElementById('appSidebar').classList.toggle('show');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}

function collapseSidebar(e) {
  if (e) e.preventDefault();
  var sidebar = document.getElementById('appSidebar');
  var isCollapsed = sidebar.classList.toggle('collapsed');
  document.body.classList.toggle('sidebar-collapsed', isCollapsed);
  localStorage.setItem('opp-sidebar', isCollapsed ? 'collapsed' : 'expanded');
  var icon = document.getElementById('collapseIcon');
  icon.className = isCollapsed ? 'bi bi-layout-sidebar-inset-reverse' : 'bi bi-layout-sidebar-inset';
}

// Theme
function toggleTheme() {
  var html = document.documentElement;
  var current = html.getAttribute('data-theme');
  var next = current === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('opp-theme', next);
  updateThemeIcon(next);
  showToast('Theme switched to ' + next + ' mode', 'info');
}
function updateThemeIcon(theme) {
  var icon = document.getElementById('themeIcon');
  if (icon) icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon';
}

// Density
function toggleDensity() {
  var body = document.body;
  var current = body.getAttribute('data-density');
  var next = current === 'compact' ? 'comfortable' : 'compact';
  body.setAttribute('data-density', next);
  localStorage.setItem('opp-density', next);
  var icon = document.getElementById('densityIcon');
  if (icon) icon.className = next === 'compact' ? 'bi bi-distribute-horizontal' : 'bi bi-distribute-vertical';
  showToast('View: ' + next, 'info');
}

// Apply saved preferences
(function() {
  var savedTheme = localStorage.getItem('opp-theme');
  if (savedTheme) {
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeIcon(savedTheme);
  } else {
    updateThemeIcon('light');
  }
  var savedDensity = localStorage.getItem('opp-density');
  if (savedDensity) {
    document.body.setAttribute('data-density', savedDensity);
    if (savedDensity === 'compact') {
      var icon = document.getElementById('densityIcon');
      if (icon) icon.className = 'bi bi-distribute-horizontal';
    }
  }
  // Sidebar: collapsed by default
  var savedSidebar = localStorage.getItem('opp-sidebar');
  if (savedSidebar !== 'expanded') {
    var sidebar = document.getElementById('appSidebar');
    if (sidebar) { sidebar.classList.add('collapsed'); document.body.classList.add('sidebar-collapsed'); }
    var ci = document.getElementById('collapseIcon');
    if (ci) ci.className = 'bi bi-layout-sidebar-inset-reverse';
  }
  // Last refreshed timestamp
  var ts = document.getElementById('lastRefreshed');
  if (ts) {
    var updateTopClock = function() { ts.textContent = new Date().toLocaleTimeString(); };
    updateTopClock();
    setInterval(updateTopClock, 1000);
  }
})();
</script>
