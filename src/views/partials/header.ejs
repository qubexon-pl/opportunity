<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Opportunities</title>
  <%
    var v = typeof assetVersion !== 'undefined' ? assetVersion : '1';
  %>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    /* Runs before any CSS is applied, so a saved dark theme never flashes white. */
    (function () {
      try {
        var saved = localStorage.getItem('opp-theme');
        var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) { /* storage disabled: light theme */ }
    })();
  </script>
  <link href="/vendor/inter/index.css" rel="stylesheet">
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css?v=<%= v %>" rel="stylesheet">
</head>
<body>
<%
  var pagePath = typeof currentPath !== 'undefined' ? currentPath : '';
  var breadcrumbItems = typeof breadcrumb !== 'undefined' ? breadcrumb : [];
  var user = typeof currentUser !== 'undefined' ? currentUser : null;
  var logoutUrl = typeof signOutUrl !== 'undefined' ? signOutUrl : null;
  function navLink(href, active, icon, label) {
    return '<a href="' + href + '" class="sidebar-link' + (active ? ' active' : '') + '" title="' + label + '"' + (active ? ' aria-current="page"' : '') + '>' +
      '<i class="bi ' + icon + '" aria-hidden="true"></i> <span>' + label + '</span></a>';
  }
%>
<a class="skip-link" href="#mainContent">Skip to content</a>

<div class="app-layout">
  <!-- Sidebar backdrop (mobile) -->
  <div class="sidebar-backdrop" id="sidebarBackdrop" data-action="toggle-sidebar"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="appSidebar" aria-label="Main navigation">
    <a href="/" class="sidebar-brand">
      <span class="brand-logo" aria-hidden="true">O</span>
      <span class="brand-text">Opportunities<small>Business Development</small></span>
    </a>

    <nav class="sidebar-nav">
      <p class="nav-section-title">Main</p>
      <%- navLink('/', pagePath === '/', 'bi-list-task', 'Pipeline') %>
      <%- navLink('/management', pagePath.startsWith('/management'), 'bi-bar-chart-steps', 'Management') %>

      <p class="nav-section-title">Operations</p>
      <%- navLink('/opportunities/new', pagePath === '/opportunities/new', 'bi-plus-circle', 'New opportunity') %>

      <p class="nav-section-title">Settings</p>
      <%- navLink('/settings', pagePath.startsWith('/settings'), 'bi-gear', 'Configuration') %>

      <button type="button" class="sidebar-link sidebar-collapse-btn mt-2" data-action="collapse-sidebar" title="Collapse sidebar" aria-controls="appSidebar">
        <i class="bi bi-layout-sidebar-inset" id="collapseIcon" aria-hidden="true"></i> <span>Collapse</span>
      </button>
    </nav>

    <!-- Sidebar footer: user info -->
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-user-avatar" aria-hidden="true"><%= user ? (user.name || 'U').charAt(0).toUpperCase() : 'O' %></div>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name"><%= user ? user.name : 'Local workspace' %></div>
          <div class="sidebar-user-email">
            <% if (user) { %>
              <%= user.email || '' %>
              <% if (logoutUrl) { %><a href="<%= logoutUrl %>" class="sidebar-signout">Sign out</a><% } %>
            <% } else { %>
              Not signed in
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <button type="button" class="btn btn-sm mobile-toggle" data-action="toggle-sidebar" aria-label="Open navigation" aria-controls="appSidebar">
        <i class="bi bi-list" aria-hidden="true"></i>
      </button>

      <!-- Breadcrumb -->
      <nav class="topbar-breadcrumb" aria-label="Breadcrumb">
        <a href="/" aria-label="Pipeline"><i class="bi bi-house-fill" aria-hidden="true"></i></a>
        <% if (breadcrumbItems.length) { %>
          <% breadcrumbItems.forEach(function(item, idx) { %>
            <span class="separator" aria-hidden="true">/</span>
            <% if (idx === breadcrumbItems.length - 1) { %>
              <span class="current" aria-current="page"><%= item.label %></span>
            <% } else { %>
              <a href="<%= item.href %>"><%= item.label %></a>
            <% } %>
          <% }) %>
        <% } %>
      </nav>

      <!-- Top bar actions -->
      <div class="topbar-actions">
        <button type="button" class="btn-palette" data-action="open-palette" title="Jump to an opportunity or person (Ctrl+K)" aria-label="Search (Ctrl+K)">
          <i class="bi bi-search" aria-hidden="true"></i><span class="btn-palette-text">Jump to…</span><kbd class="btn-palette-kbd">Ctrl K</kbd>
        </button>
        <a href="/opportunities/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i><span class="d-none d-sm-inline">New opportunity</span><span class="d-sm-none">New</span></a>
        <button type="button" class="btn-density-toggle" data-action="toggle-density" title="Toggle compact/comfortable view (Ctrl+D)" aria-label="Toggle compact view">
          <i class="bi bi-distribute-vertical" id="densityIcon" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn-theme-toggle" data-action="toggle-theme" title="Toggle dark/light mode (Ctrl+Shift+D)" aria-label="Toggle dark mode">
          <i class="bi bi-moon" id="themeIcon" aria-hidden="true"></i>
        </button>
      </div>
    </header>

    <!-- Page content -->
    <main class="page-content" id="mainContent" tabindex="-1">

      <div data-flash-region>
        <% (typeof flashSuccess !== 'undefined' ? flashSuccess : []).forEach(function(message) { %>
          <div class="alert alert-success alert-dismissible fade show" role="status" data-auto-dismiss>
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
          </div>
        <% }) %>
        <% (typeof flashError !== 'undefined' ? flashError : []).forEach(function(message) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
          </div>
        <% }) %>
      </div>

<script src="/js/shell.js?v=<%= v %>"></script>
