    </div><!-- /.page-content -->

    <footer class="app-footer">
      Opportunities App &copy; <%= new Date().getFullYear() %> &nbsp;|&nbsp;
      <span class="kbd-hint">?</span> Keyboard shortcuts
    </footer>
  </div><!-- /.main-content -->
</div><!-- /.app-layout -->

<!-- Toast container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Global reload overlay -->
<div id="reloadOverlay" class="reload-overlay d-none">
  <div class="reload-overlay-card">
    <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
    <span id="reloadOverlayText">Reloading...</span>
  </div>
</div>

<!-- Global confirmation modal -->
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmActionTitle">Please confirm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="confirmActionBody">Are you sure?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmActionBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Keyboard shortcuts modal -->
<div class="modal fade" id="kbdModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title">Keyboard Shortcuts</h6>
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-3" style="font-size:0.82rem;">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td><span class="kbd-hint">/</span></td><td>Focus search</td></tr>
            <tr><td><span class="kbd-hint">N</span></td><td>New opportunity</td></tr>
            <tr><td><span class="kbd-hint">G then P</span></td><td>Go to Pipeline</td></tr>
            <tr><td><span class="kbd-hint">G then M</span></td><td>Go to Management</td></tr>
            <tr><td><span class="kbd-hint">G then S</span></td><td>Go to Configuration</td></tr>
            <tr><td><span class="kbd-hint">Ctrl+Shift+D</span></td><td>Toggle dark mode</td></tr>
            <tr><td><span class="kbd-hint">Ctrl+D</span></td><td>Toggle density</td></tr>
            <tr><td><span class="kbd-hint">?</span></td><td>Show this help</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
// ──── Toast notification system ────
function showToast(message, type) {
  type = type || 'info';
  var container = document.getElementById('toastContainer');
  if (!container) return;
  var toast = document.createElement('div');
  toast.className = 'toast-item toast-' + type;
  var iconMap = { success: 'bi-check-circle-fill text-success', error: 'bi-x-circle-fill text-danger', info: 'bi-info-circle-fill text-primary' };
  toast.innerHTML = '<i class="bi ' + (iconMap[type] || iconMap.info) + '"></i><span></span>';
  toast.querySelector('span').textContent = message;
  container.appendChild(toast);
  setTimeout(function() {
    toast.style.opacity = '0';
    toast.style.transform = 'translateX(100%)';
    toast.style.transition = 'all .3s ease';
    setTimeout(function() { toast.remove(); }, 300);
  }, 3500);
}

// ──── Table filter (global helper) ────
function filterTable(input, tableId) {
  var filter = (input.value || '').toLowerCase();
  document.querySelectorAll('#' + tableId + ' tbody tr').forEach(function(row) {
    var text = (row.getAttribute('data-filter') || row.textContent || '').toLowerCase();
    row.style.display = text.includes(filter) ? '' : 'none';
  });
}

function showPageReloading(message) {
  var overlay = document.getElementById('reloadOverlay');
  var text = document.getElementById('reloadOverlayText');
  if (!overlay) return;
  if (text && message) text.textContent = message;
  overlay.classList.remove('d-none');
}

function reloadPageWithMessage(message, delayMs) {
  showPageReloading(message || 'Reloading...');
  var wait = typeof delayMs === 'number' ? delayMs : 0;
  setTimeout(function() { window.location.reload(); }, wait);
}

var confirmActionModal;
var confirmActionCallback = null;
function showConfirmAction(options) {
  options = options || {};
  var titleEl = document.getElementById('confirmActionTitle');
  var bodyEl = document.getElementById('confirmActionBody');
  var actionBtn = document.getElementById('confirmActionBtn');
  if (!titleEl || !bodyEl || !actionBtn) return;
  titleEl.textContent = options.title || 'Please confirm';
  bodyEl.textContent = options.message || 'Are you sure?';
  actionBtn.textContent = options.confirmText || 'Confirm';
  actionBtn.className = 'btn ' + (options.confirmClass || 'btn-danger');
  confirmActionCallback = typeof options.onConfirm === 'function' ? options.onConfirm : null;
  confirmActionModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmActionModal'));
  confirmActionModal.show();
}

// Any form with data-confirm is routed through the confirmation modal.
document.addEventListener('submit', function(event) {
  var form = event.target;
  if (!form.hasAttribute || !form.hasAttribute('data-confirm') || form.dataset.confirmed === 'true') return;
  event.preventDefault();
  showConfirmAction({
    title: form.getAttribute('data-confirm-title') || 'Please confirm',
    message: form.getAttribute('data-confirm'),
    confirmText: form.getAttribute('data-confirm-text') || 'Delete',
    onConfirm: function() {
      form.dataset.confirmed = 'true';
      form.submit();
    }
  });
});

var confirmActionBtn = document.getElementById('confirmActionBtn');
if (confirmActionBtn) {
  confirmActionBtn.addEventListener('click', function() {
    if (confirmActionCallback) confirmActionCallback();
    confirmActionCallback = null;
    if (confirmActionModal) confirmActionModal.hide();
  });
}

// ──── Keyboard shortcuts ────
(function() {
  var gPressed = false;
  var gTimeout = null;

  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT' || e.target.isContentEditable) return;

    if (e.key === '?' && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      bootstrap.Modal.getOrCreateInstance(document.getElementById('kbdModal')).toggle();
      return;
    }

    if (e.key === 'D' && e.ctrlKey && e.shiftKey) {
      e.preventDefault();
      toggleTheme();
      return;
    }

    if (e.key === 'd' && e.ctrlKey && !e.shiftKey) {
      e.preventDefault();
      toggleDensity();
      return;
    }

    if (e.key === '/') {
      var searchInput = document.querySelector('input[type="search"], input[name="q"], input[placeholder*="earch"], input[placeholder*="ilter"]');
      if (searchInput) {
        e.preventDefault();
        searchInput.focus();
        return;
      }
    }

    if ((e.key === 'n' || e.key === 'N') && !e.ctrlKey && !e.altKey && !e.metaKey) {
      e.preventDefault();
      window.location.href = '/opportunities/new';
      return;
    }

    if (e.key === 'g' && !e.ctrlKey && !e.altKey && !e.metaKey) {
      if (gPressed) return;
      gPressed = true;
      clearTimeout(gTimeout);
      gTimeout = setTimeout(function() { gPressed = false; }, 1000);
      return;
    }

    if (gPressed) {
      gPressed = false;
      clearTimeout(gTimeout);
      var navMap = { p: '/', h: '/', m: '/management', s: '/settings', n: '/opportunities/new' };
      var dest = navMap[e.key];
      if (dest) { e.preventDefault(); window.location.href = dest; }
    }
  });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
<script src="/js/multiselect.js"></script>
</body>
</html>
