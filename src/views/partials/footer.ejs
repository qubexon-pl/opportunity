    </main><!-- /.page-content -->

    <footer class="app-footer">
      Opportunities App &copy; <%= new Date().getFullYear() %> &nbsp;|&nbsp;
      <button type="button" class="btn-link-plain" data-action="show-shortcuts"><span class="kbd-hint">?</span> Keyboard shortcuts</button>
    </footer>
  </div><!-- /.main-content -->
</div><!-- /.app-layout -->

<!-- Toast container -->
<div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="false"></div>

<!-- Global busy indicator: shown while data is loading or saving -->
<div id="reloadOverlay" class="reload-overlay d-none" role="status" aria-live="polite">
  <div class="reload-overlay-card">
    <div class="spinner-border text-primary" aria-hidden="true"></div>
    <span id="reloadOverlayText">Working...</span>
  </div>
</div>

<!-- Global confirmation modal -->
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmActionTitle">Please confirm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="confirmActionBody">Are you sure?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmActionBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Quick next step: opened from the pipeline row or the upcoming card -->
<div class="modal fade" id="quickStepModal" tabindex="-1" aria-labelledby="quickStepTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="quickStepForm" method="post" data-no-live>
      <div class="modal-header">
        <h5 class="modal-title" id="quickStepTitle">Add next step</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-3" id="quickStepFor"></p>
        <div class="mb-3">
          <label class="form-label" for="quickStepTitleInput">Next step</label>
          <input class="form-control" id="quickStepTitleInput" name="title" required maxlength="250" placeholder="e.g. Send proposal draft">
        </div>
        <div>
          <label class="form-label" for="quickStepDue">Due date</label>
          <input type="date" class="form-control" id="quickStepDue" name="dueDate">
          <div class="d-flex gap-2 mt-2 flex-wrap" data-role="due-shortcuts">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-due-offset="0">Today</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-due-offset="1">Tomorrow</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-due-offset="next-monday">Next Monday</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-due-offset="7">In a week</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add step</button>
      </div>
    </form>
  </div>
</div>

<!-- Command palette (Ctrl+K) -->
<div class="modal" id="paletteModal" tabindex="-1" aria-label="Jump to" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable palette-dialog">
    <div class="modal-content">
      <div class="palette-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" class="form-control" id="paletteInput" placeholder="Jump to an opportunity, person or page…" autocomplete="off"
               role="combobox" aria-expanded="true" aria-controls="paletteResults" aria-autocomplete="list" data-no-shortcut-focus>
      </div>
      <ul class="palette-results" id="paletteResults" role="listbox"></ul>
      <div class="palette-hint"><kbd>↑</kbd><kbd>↓</kbd> to move &middot; <kbd>Enter</kbd> to open &middot; <kbd>Esc</kbd> to close</div>
    </div>
  </div>
</div>

<!-- Keyboard shortcuts modal -->
<div class="modal fade" id="kbdModal" tabindex="-1" aria-labelledby="kbdModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title" id="kbdModalTitle">Keyboard Shortcuts</h6>
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3 small-modal-body">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td><span class="kbd-hint">Ctrl+K</span></td><td>Jump to opportunity or person</td></tr>
            <tr><td><span class="kbd-hint">/</span></td><td>Focus search</td></tr>
            <tr><td><span class="kbd-hint">Shift+N</span></td><td>New opportunity</td></tr>
            <tr><td><span class="kbd-hint">G then P</span></td><td>Go to Pipeline</td></tr>
            <tr><td><span class="kbd-hint">G then M</span></td><td>Go to Management</td></tr>
            <tr><td><span class="kbd-hint">G then S</span></td><td>Go to Configuration</td></tr>
            <tr><td><span class="kbd-hint">G then N</span></td><td>New opportunity</td></tr>
            <tr><td><span class="kbd-hint">F</span></td><td>Timeline full page</td></tr>
            <tr><td><span class="kbd-hint">Ctrl+S</span></td><td>Save the opportunity</td></tr>
            <tr><td><span class="kbd-hint">Ctrl+Shift+D</span></td><td>Toggle dark mode</td></tr>
            <tr><td><span class="kbd-hint">Ctrl+D</span></td><td>Toggle density</td></tr>
            <tr><td><span class="kbd-hint">?</span></td><td>Show this help</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%
  var v = typeof assetVersion !== 'undefined' ? assetVersion : '1';
  var extraScripts = typeof pageScripts !== 'undefined' && Array.isArray(pageScripts) ? pageScripts : [];
%>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/busy.js?v=<%= v %>"></script>
<script src="/js/app.js?v=<%= v %>"></script>
<script src="/js/view-state.js?v=<%= v %>"></script>
<script src="/js/live-update.js?v=<%= v %>"></script>
<% extraScripts.forEach(function(src) { %>
<script src="<%= src %>?v=<%= v %>"></script>
<% }) %>
</body>
</html>
