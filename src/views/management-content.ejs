<script type="application/json" id="mgmtPeopleDailyHours"><%- JSON.stringify(peopleDailyHours || {}).replace(/</g, '\\u003c') %></script>
<div class="page-hero page-hero--capacity page-hero--tall">
  <div>
    <h2 class="hero-title"><i class="bi bi-people-fill hero-icon" aria-hidden="true"></i>Team capacity</h2>
    <p class="hero-sub mb-0">
      Capacity window: <%= toDateText(view.window.start) %> &rarr; <%= toDateText(view.window.endExclusive) %>
      (<%= view.capacityBusinessDays %> working days, baseline <%= monthlyCapacity %>h/month).
    </p>
  </div>
  <div class="hero-stats">
    <span class="hero-stat">Assignments: <strong><%= view.stats.total %></strong></span>
    <span class="hero-stat">Committed: <strong><%= view.stats.committed %></strong></span>
    <span class="hero-stat">Soft booked: <strong><%= view.stats.soft %></strong></span>
    <span class="hero-stat">On hold: <strong><%= view.stats.onHold %></strong></span>
    <span class="hero-stat">Hidden: <strong><%= view.stats.hidden %></strong></span>
  </div>
</div>

<%
  var unitNames = { weeks: ['week', 'weeks'], months: ['month', 'months'], quarters: ['quarter', 'quarters'], halfyears: ['half year', 'half years'] };
  var unitName = unitNames[perspective] || unitNames.months;
  var analysisUnits = view.window.units;
  var analysisScope = periodDirection === 'current'
    ? 'Current ' + unitName[0]
    : (periodDirection === 'back' ? 'Last ' : 'Next ') + analysisUnits + ' ' + unitName[analysisUnits === 1 ? 0 : 1];
  var analysisRange = view.window.fromKey === view.window.toKey ? view.window.fromKey : view.window.fromKey + ' to ' + view.window.toKey;
%>
<div class="analysis-period" role="status">
  <i class="bi bi-calendar-range" aria-hidden="true"></i>
  <span>Analysis done for <strong><%= analysisRange %></strong></span>
  <span class="analysis-period-meta">
    <%= analysisScope %> &middot; <%= view.window.startText %> &ndash; <%= view.window.endText %>
    &middot; <%= view.capacityBusinessDays %> working days<% if (view.window.isPast) { %> &middot; past period<% } %>
  </span>
</div>

<% if (typeof loadError !== 'undefined' && loadError) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Could not load assignment data: <%= loadError %>
  </div>
<% } %>

<%
  // Team utilization against the capacity-weighted average of personal targets.
  var chargeTarget = view.chargeability.target;
  var chargeReal = view.chargeability.real;
  var chargeBadge = { cls: 'is-' + view.chargeability.status.tone, text: view.chargeability.status.label };
  function ragDot(status) {
    return '<span class="rag-dot rag-dot--' + status.tone + '" title="' + status.label + '" aria-label="' + status.label + '"></span>';
  }
%>
<div class="row g-3 mb-3 mgmt-kpis">
  <div class="col-sm-6 col-xl-3">
    <div class="mgmt-kpi mgmt-kpi--members">
      <div class="mgmt-kpi-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
      <div>
        <div class="mgmt-kpi-label">Team members</div>
        <div class="mgmt-kpi-value"><%= view.people.length %></div>
        <div class="mgmt-kpi-sub"><%= view.capacityBusinessDays %> working days in window</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="mgmt-kpi mgmt-kpi--assignments">
      <div class="mgmt-kpi-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></div>
      <div>
        <div class="mgmt-kpi-label">Assignments</div>
        <div class="mgmt-kpi-value"><%= view.stats.total %></div>
        <div class="mgmt-kpi-sub"><%= view.stats.committed %> committed &middot; <%= view.stats.soft %> soft booked</div>
      </div>
    </div>
  </div>
  <div class="col-xl-6">
    <div class="mgmt-kpi mgmt-kpi--charge">
      <div class="mgmt-kpi-icon"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i></div>
      <div class="flex-grow-1">
        <div class="mgmt-kpi-label" title="Utilization = committed hours ÷ capacity in the window. Status compares it with the average chargeability target, weighted by each person's capacity.">
          Utilization vs chargeability target <i class="bi bi-info-circle ms-1" aria-hidden="true"></i>
        </div>
        <div class="d-flex align-items-baseline gap-3 flex-wrap">
          <div class="mgmt-kpi-value"><%= chargeReal %>%</div>
          <span class="mgmt-kpi-badge <%= chargeBadge.cls %>"><%= chargeBadge.text %></span>
          <span class="mgmt-kpi-sub ms-auto">Average target: <strong><%= chargeTarget %>%</strong> &middot; gap <%= view.chargeability.gap > 0 ? '+' : '' %><%= view.chargeability.gap %> pts</span>
        </div>
        <div class="mgmt-kpi-bar" title="Utilization <%= chargeReal %>% against a <%= chargeTarget %>% average target">
          <div class="mgmt-kpi-bar-fill" style="width: <%= Math.min(chargeReal, 100) %>%;"></div>
          <div class="mgmt-kpi-bar-target" style="left: <%= Math.min(chargeTarget, 100) %>%;"></div>
        </div>
        <div class="mgmt-kpi-sub">Predicted incl. soft bookings: <strong class="<%= view.chargeability.predictedClass %>"><%= view.chargeability.predicted %>%</strong></div>
      </div>
    </div>
  </div>
</div>

<ul class="nav nav-tabs mgmt-tabs mb-3" id="managementTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabCapacity" type="button" role="tab">
      <i class="bi bi-people me-1" aria-hidden="true"></i>Team capacity
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAssignments" type="button" role="tab">
      <i class="bi bi-list-ul me-1" aria-hidden="true"></i>Assignments
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabTimeline" type="button" role="tab">
      <i class="bi bi-bar-chart-steps me-1" aria-hidden="true"></i>Timeline
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPeople" type="button" role="tab">
      <i class="bi bi-person-lines-fill me-1" aria-hidden="true"></i>People
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- ═══════════════ Tab 1: Team capacity ═══════════════ -->
  <div class="tab-pane fade show active" id="tabCapacity" role="tabpanel">

    <div class="card mb-4 filter-card">
      <div class="card-body" id="collapsePerspective">
        <form method="get" action="/management" class="row g-3 align-items-end mgmt-filter-form" data-mgmt-form>
          <input type="hidden" name="applied" value="1">
          <div class="col-xl col-md-4 col-6">
            <label class="form-label" for="perspective">Timeline unit</label>
            <select class="form-select form-select-sm" id="perspective" name="perspective">
              <% timelineUnitOptions.forEach(function(option) { %>
                <option value="<%= option.key %>" <%= perspective === option.key ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-xl col-md-4 col-6">
            <label class="form-label" for="units">Horizon</label>
            <%- include('partials/horizon-input', { horizonClass: 'form-control form-control-sm' }) %>
          </div>
          <%/* Back / Current / Next combine with the horizon to pick the window:
               back by 1 month in November measures October. */ %>
          <div class="col-xl col-md-4 col-6">
            <%- include('partials/period-select', {
              perspective: perspective,
              periodDirection: periodDirection,
              periodSelectClass: 'form-select form-select-sm',
              periodHint: view.window.label + (view.window.isPast ? ' (past)' : ''),
            }) %>
          </div>
          <div class="col-xl col-md-4 col-6">
            <%- include('partials/multiselect', {
              id: 'filter-timeline-stage',
              name: 'stage',
              label: 'Stage',
              size: 'sm',
              allLabel: 'All stages',
              selected: stageFilters,
              options: [{ value: 'free', label: 'Free capacity' }].concat(stageLegend.map(function(item) {
                return { value: item.label, label: item.label };
              }))
            }) %>
          </div>
          <div class="col-xl col-md-4 col-6">
            <%- include('partials/multiselect', {
              id: 'filter-timeline-status',
              name: 'status',
              label: 'Status',
              size: 'sm',
              allLabel: 'All statuses',
              selected: statusFilters,
              options: statusOptions.map(function(status) { return { value: status, label: status }; })
            }) %>
          </div>
          <div class="col-xl col-md-4 col-6">
            <%- include('partials/multiselect', {
              id: 'filter-timeline-manager',
              name: 'manager',
              label: 'Manager',
              size: 'sm',
              allLabel: 'All managers',
              selected: managerFilters,
              options: managerOptions.map(function(name) { return { value: name, label: name }; })
            }) %>
          </div>
          <div class="col-xl col-md-4 col-6">
            <%- include('partials/multiselect', {
              id: 'filter-timeline-person',
              name: 'person',
              label: 'Person',
              size: 'sm',
              allLabel: 'All people',
              selected: personFilters,
              options: personOptions.map(function(name) { return { value: name, label: name }; })
            }) %>
          </div>
          <div class="col-xl-auto col-md-4 col-12 d-flex align-items-center gap-3">
            <button class="btn btn-sm btn-primary btn-pill" type="submit"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Apply</button>
            <a class="filter-clear" href="/management?applied=1" data-mgmt-link>Clear all</a>
          </div>
        </form>
        <form method="post" action="/management/defaults" class="filter-defaults d-flex align-items-center gap-2 flex-wrap" data-mgmt-defaults>
          <input type="hidden" name="perspective" value="<%= perspective %>">
          <input type="hidden" name="units" value="<%= unitsToShow %>">
          <input type="hidden" name="period" value="<%= periodDirection %>">
          <% stageFilters.forEach(function(stage) { %><input type="hidden" name="stage" value="<%= stage %>"><% }) %>
          <% statusFilters.forEach(function(status) { %><input type="hidden" name="status" value="<%= status %>"><% }) %>
          <% personFilters.forEach(function(name) { %><input type="hidden" name="person" value="<%= name %>"><% }) %>
          <% managerFilters.forEach(function(name) { %><input type="hidden" name="manager" value="<%= name %>"><% }) %>
          <button class="btn btn-sm btn-outline-primary" type="submit" <%= filtersMatchDefault ? 'disabled' : '' %>>
            <i class="bi bi-pin-angle me-1" aria-hidden="true"></i>Save as my default
          </button>
          <span class="text-muted small">
            Current default: <%= savedDefaults.perspective %> &middot; <%= savedDefaults.units %> units &middot;
            <%= savedDefaults.stages.length ? savedDefaults.stages.join(', ') : 'all stages' %> &middot;
            <%= savedDefaults.statuses.length ? savedDefaults.statuses.join(', ') : 'all statuses' %> &middot;
            <%= savedDefaults.managers.length ? savedDefaults.managers.join(', ') : 'all managers' %> &middot;
            <%= savedDefaults.people.length ? savedDefaults.people.join(', ') : 'all people' %>
          </span>
        </form>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapsePeople" aria-expanded="true">
          <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-people me-2" aria-hidden="true"></i>People summary</span>
        </button>
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div class="d-flex align-items-center gap-2">
            <label class="text-muted small mb-0" for="peopleSort">Sort by</label>
            <select class="form-select form-select-sm" id="peopleSort">
              <% peopleSortFields.forEach(function(field) { %>
                <option value="<%= field.key %>" <%= view.peopleSort.key === field.key ? 'selected' : '' %>><%= field.label %></option>
              <% }) %>
            </select>
            <select class="form-select form-select-sm" id="peopleDir" aria-label="Sort direction">
              <option value="asc" <%= view.peopleSort.dir === 'asc' ? 'selected' : '' %>>Ascending</option>
              <option value="desc" <%= view.peopleSort.dir === 'desc' ? 'selected' : '' %>>Descending</option>
            </select>
          </div>
          <div class="team-kpi" title="Real counts committed work; predicted adds soft bookings. Status compares real utilization with the average target.">
            <%- ragDot(view.chargeability.status) %>
            <span class="team-kpi-label">Team utilization</span>
            <span class="team-kpi-value <%= view.chargeability.realClass %>"><%= view.chargeability.real %>%</span>
            <span class="team-kpi-sep">/</span>
            <span class="team-kpi-value <%= view.chargeability.predictedClass %>"><%= view.chargeability.predicted %>%</span>
          </div>
          <span class="text-muted small">real / predicted &middot; target <%= view.chargeability.target %>%</span>
          <% if (view.chargeability.absenceHours > 0) { %>
            <span class="absence-impact small"
                  title="Absence removes working days from the window, so the same committed hours are measured against a smaller base.">
              <i class="bi bi-calendar-x me-1" aria-hidden="true"></i>
              <%= view.chargeability.absenceHours %>h absence across <%= view.chargeability.absentPeople %>
              <%= view.chargeability.absentPeople === 1 ? 'person' : 'people' %>
              <% if (view.chargeability.absencePercentPoints > 0) { %>
                (+<%= view.chargeability.absencePercentPoints %> pts)
              <% } %>
            </span>
          <% } %>
        </div>
      </div>
      <div class="card-body collapse show" id="collapsePeople">
        <div class="row g-3" id="peopleGrid">
          <% view.people.forEach(function(member) { %>
            <div class="col-xl-3 col-lg-4 col-md-6"
                 data-person="<%= member.person %>"
                 data-role="<%= member.role || '' %>"
                 data-daily="<%= member.dailyHours %>"
                 data-capacity="<%= member.capacityHours %>"
                 data-committed="<%= member.activeHours %>"
                 data-soft="<%= member.softHours %>"
                 data-free="<%= member.availableHours %>"
                 data-held="<%= member.heldHours %>"
                 data-absence="<%= member.absenceHours %>"
                 data-real="<%= member.chargeabilityReal %>"
                 data-predicted="<%= member.chargeabilityPredicted %>"
                 data-target="<%= member.chargeabilityTarget %>"
                 data-gap="<%= member.chargeabilityGap %>">
              <div class="card h-100 capacity-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <a class="fw-semibold person-link" href="/management/people/<%= encodeURIComponent(member.person) %>?perspective=<%= perspective %>&units=<%= unitsToShow %>&period=<%= periodDirection %>"><%= member.person %></a>
                      <% if (member.role) { %><div class="person-role small text-muted"><%= member.role %></div><% } %>
                    </div>
                    <span class="small text-muted text-nowrap"><%= member.dailyHours %>h/day</span>
                  </div>

                  <div class="kpi-pair" title="Utilization = committed hours divided by capacity in the selected window">
                    <div class="kpi">
                      <div class="kpi-value <%= member.chargeabilityClass %>"><%= member.chargeabilityReal %>%</div>
                      <div class="kpi-label">Utilization</div>
                    </div>
                    <div class="kpi">
                      <div class="kpi-value <%= member.chargeabilityPredictedClass %>"><%= member.chargeabilityPredicted %>%</div>
                      <div class="kpi-label">Predicted</div>
                    </div>
                    <div class="kpi">
                      <div class="kpi-value kpi-target"><%= member.chargeabilityTarget %>%</div>
                      <div class="kpi-label">Target</div>
                    </div>
                  </div>
                  <div class="rag-line small mb-2 rag-line--<%= member.chargeabilityStatus.tone %>">
                    <%- ragDot(member.chargeabilityStatus) %><%= member.chargeabilityStatus.label %>
                    <span class="text-muted">(<%= member.chargeabilityGap > 0 ? '+' : '' %><%= member.chargeabilityGap %> pts)</span>
                  </div>

                  <div class="capacity-track" title="<%= member.activeHours %>h committed, <%= member.softHours %>h soft booked">
                    <div class="capacity-fill" style="width: <%= member.assignedPercent.toFixed(2) %>%;"></div>
                    <div class="capacity-fill-soft" style="width: <%= member.softPercent.toFixed(2) %>%;"></div>
                  </div>
                  <div class="d-flex justify-content-between small mt-2">
                    <span class="text-muted"><%= member.activeHours %>h committed</span>
                    <span class="<%= capacityClass(member.availableHours) %>"><%= member.availableHours %>h free</span>
                  </div>
                  <div class="d-flex justify-content-between small mt-1">
                    <span class="soft-hint"><%= member.softHours %>h soft booked</span>
                    <span class="text-muted"><%= member.availableIfWonHours %>h if all won</span>
                  </div>
                  <div class="text-muted small mt-1">
                    Capacity <%= member.capacityHours %>h in window<% if (member.absentDays > 0) { %>
                      <span class="absence-hint">(<%= member.grossCapacityHours %>h &minus; <%= member.absenceHours %>h absence)</span>
                    <% } %>
                  </div>
                  <% if (member.absentDays > 0) { %>
                    <div class="absence-impact small mt-2"
                         title="<%= member.absences.map(function(a) { return a.kind + ' ' + a.startDate + ' to ' + a.endDate + ' (' + a.daysInWindow + 'd)'; }).join('\n') %>&#10;Absence removes days from the window, so the same committed hours are measured against a smaller base.">
                      <i class="bi bi-calendar-x me-1" aria-hidden="true"></i>
                      Absence removes <strong><%= member.absenceHours %>h</strong> (<%= member.absentDays %>d)
                      <% if (member.absencePercentPoints > 0) { %>
                        &middot; utilization <%= member.chargeabilityReal %>% instead of
                        <%= member.chargeabilityWithoutAbsence %>% (+<%= member.absencePercentPoints %> pts)
                      <% } else { %>
                        &middot; no committed work yet, so utilization is unchanged
                      <% } %>
                    </div>
                  <% } %>
                  <% if (member.heldHours > 0) { %>
                    <div class="hold-impact small mt-2"
                         title="<%= member.heldAssignments %> assignment<%= member.heldAssignments === 1 ? '' : 's' %> paused in this window. Without the hold this person would be at <%= member.chargeabilityWithoutHolds %>% instead of <%= member.chargeabilityReal %>.">
                      <i class="bi bi-pause-circle me-1" aria-hidden="true"></i>
                      Holds free <strong><%= member.heldHours %>h</strong> &middot;
                      utilization <%= member.chargeabilityReal %>% instead of <%= member.chargeabilityWithoutHolds %>%
                      (&minus;<%= member.holdPercentPoints %> pts)
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
          <% if (!view.people.length) { %>
            <div class="col-12"><div class="alert alert-info mb-0">
              <% if (personFilters.length) { %>
                No people match the current person filter.
              <% } else { %>
                No people configured. Add people in <a href="/settings">Configuration</a>.
              <% } %>
            </div></div>
          <% } %>
        </div>
      </div>
    </div>

  </div><!-- /#tabCapacity -->

  <!-- ═══════════════ Tab 2: Assignments ═══════════════ -->
  <div class="tab-pane fade" id="tabAssignments" role="tabpanel">

    <%- include('partials/period-filter', { pfId: 'Assignments' }) %>

    <%- include('partials/quick-assign', { qaSuffix: 'Assignments' }) %>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseAssignments" aria-expanded="true">
          <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-list-ul me-2" aria-hidden="true"></i>Assignments (<%= view.assignmentRows.length %>)</span>
        </button>
        <div class="d-flex align-items-center gap-2">
          <input type="search" class="form-control form-control-sm inline-filter" placeholder="Filter rows..." aria-label="Filter assignments" data-filter-grouped="assignmentTable">
          <a class="btn btn-sm btn-outline-success" id="exportAssignmentsBtn" href="/management/assignments/export" title="Export assignments to Excel">
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Export
          </a>
        </div>
      </div>
      <div class="card-body p-0 collapse show" id="collapseAssignments">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 management-table" id="assignmentTable">
            <thead>
              <tr>
                <%
                  var numericSorts = ['allocation', 'hours'];
                  function sortHref(key) {
                    var dir = view.sort.key === key && view.sort.dir === 'asc' ? 'desc' : 'asc';
                    return '/management?' + queryWith({ sort: key, dir: dir });
                  }
                  function sortIcon(key) {
                    if (view.sort.key !== key) return 'bi-arrow-down-up';
                    return view.sort.dir === 'asc' ? 'bi-sort-down-alt' : 'bi-sort-up-alt';
                  }
                %>
                <% assignmentSortFields.forEach(function(field) { %>
                  <th class="<%= numericSorts.indexOf(field.key) !== -1 ? 'text-end' : '' %>">
                    <a class="sort-link <%= view.sort.key === field.key ? 'is-active' : '' %>"
                       href="<%= sortHref(field.key) %>"
                       data-mgmt-link
                       title="Sort by <%= field.label %>"><%= field.label %><i class="bi <%= sortIcon(field.key) %> ms-1" aria-hidden="true"></i></a>
                  </th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <%
                var assignmentGroups = [];
                var groupMap = {};
                view.assignmentRows.forEach(function(assignment) {
                  var key = assignment.OpportunityId;
                  if (!groupMap[key]) {
                    groupMap[key] = { id: key, name: assignment.OpportunityName, rows: [] };
                    assignmentGroups.push(groupMap[key]);
                  }
                  groupMap[key].rows.push(assignment);
                });
              %>
              <% assignmentGroups.forEach(function(group) { %>
                <tr class="assignment-group-header">
                  <td colspan="9">
                    <i class="bi bi-folder2-open me-2" aria-hidden="true"></i><%= group.name %>
                    <span class="badge text-bg-secondary ms-1"><%= group.rows.length %></span>
                  </td>
                </tr>
                <% group.rows.forEach(function(assignment) { %>
                <tr>
                  <td class="fw-semibold">
                    <a class="person-link" href="/management/people/<%= encodeURIComponent(assignment.PersonName) %>?perspective=<%= perspective %>&units=<%= unitsToShow %>&period=<%= periodDirection %>"><%= assignment.PersonName %></a>
                  </td>
                  <td>
                    <%
                      var scope = assignment.scope;
                      var scopeIcon = scope.state === 'over' ? 'bi-arrow-up-right' : scope.state === 'within' ? 'bi-arrow-down-right' : '';
                      var scopeClass = scope.state === 'over' ? 'scope-over' : scope.state === 'within' ? 'scope-within' : '';
                      var scopeTitle = scope.state === 'unknown'
                        ? 'This opportunity has no stated hours, so there is nothing to compare the assignments against.'
                        : scope.assignedHours + 'h assigned across ' + scope.assignmentCount + ' allocation' + (scope.assignmentCount === 1 ? '' : 's')
                          + ' of the ' + scope.scopeHours + 'h project scope (' + scope.percentOfScope + '%).\n'
                          + (scope.state === 'over'
                              ? 'Over scope by ' + scope.differenceHours + 'h.'
                              : 'Within scope, ' + Math.abs(scope.differenceHours) + 'h still unassigned.');
                    %>
                    <a href="/opportunities/<%= assignment.OpportunityId %>#assignments"><%= assignment.OpportunityName %></a>
                    <% if (scopeIcon) { %>
                      <i class="bi <%= scopeIcon %> scope-arrow <%= scopeClass %>" title="<%= scopeTitle %>" aria-hidden="true"></i>
                      <div class="scope-hint small <%= scopeClass %>" title="<%= scopeTitle %>">
                        <%= scope.assignedHours %>h / <%= scope.scopeHours %>h
                        <%= scope.state === 'over' ? '(+' + scope.differenceHours + 'h over)' : '(' + Math.abs(scope.differenceHours) + 'h left)' %>
                      </div>
                    <% } %>
                  </td>
                  <td><span class="pipeline-oppid"><%= assignment.OppId || '-' %></span></td>
                  <td><span class="stage-dot <%= stageAccentClass(assignment.Stage) %>"></span><%= assignment.Stage || '-' %> <span class="text-muted small">(<%= stageStatusLabel(assignment.Stage) %>)</span></td>
                  <td class="text-nowrap">
                    <%= assignment.StartDate || '-' %> &rarr; <%= assignment.EndDate || '-' %>
                    <% if (assignment.hasHolds) { %>
                      <% assignment.holds.forEach(function(hold) { %>
                        <div class="hold-hint small<%= isHoldExpired(hold) ? ' text-decoration-line-through text-muted' : '' %>"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>On hold <%= hold.startDate %> &rarr; <%= hold.endDate %></div>
                      <% }) %>
                    <% } %>
                  </td>
                  <td class="text-end" title="<%= assignment.InitialAllocatedHours %>h of the <%= assignment.OpportunityHours %>h project scope"><%= assignment.InitialPercent || 0 %>%</td>
                  <td class="text-end"><%= assignment.AllocatedHours %>h</td>
                  <td class="text-end">
                    <span class="booking-state <%= assignment.IsCommitted ? 'is-committed' : 'is-soft' %>">
                      <%= assignment.IsCommitted ? 'Committed' : 'Soft' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <form method="post" action="/management/assignments/<%= assignment.Id %>/visibility" data-mgmt-visibility data-assignment-id="<%= assignment.Id %>" data-next-visible="<%= assignment.IsTimelineVisible ? 'false' : 'true' %>">
                      <button class="btn btn-sm <%= assignment.IsTimelineVisible ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit">
                        <%= assignment.IsTimelineVisible ? 'Hide' : 'Show' %>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              <% }) %>
              <% if (!view.assignmentRows.length) { %>
                <tr><td colspan="8" class="p-0">
                  <%- include('partials/empty-state', {
                    esArt: 'assignments',
                    esTitle: 'Nobody is booked in this window',
                    esHint: 'Assign someone from the timeline below, or widen the period and filters.'
                  }) %>
                </td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div><!-- /#tabAssignments -->

  <!-- ═══════════════ Tab 3: Timeline ═══════════════ -->
  <div class="tab-pane fade" id="tabTimeline" role="tabpanel">

    <%- include('partials/period-filter', { pfId: 'Timeline' }) %>

    <%- include('partials/quick-assign', { qaSuffix: 'Timeline' }) %>

    <div class="card mb-4" id="timelineCard">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapseTimeline" aria-expanded="true">
          <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-bar-chart-steps me-2" aria-hidden="true"></i>Timeline</span>
        </button>
        <div class="timeline-legend d-flex flex-wrap gap-2">
          <%
            var baseQuery = 'applied=1&perspective=' + encodeURIComponent(perspective) + '&units=' + encodeURIComponent(unitsToShow) + '&period=' + encodeURIComponent(periodDirection);
            statusFilters.forEach(function(s) { baseQuery += '&status=' + encodeURIComponent(s); });
            personFilters.forEach(function(p) { baseQuery += '&person=' + encodeURIComponent(p); });
            function toggleHref(value) {
              var next = stageFilters.indexOf(value) !== -1
                ? stageFilters.filter(function(s) { return s !== value; })
                : stageFilters.concat([value]);
              var qs = baseQuery;
              next.forEach(function(s) { qs += '&stage=' + encodeURIComponent(s); });
              return '/management?' + qs;
            }
          %>
          <a class="legend-chip <%= stageFilters.length === 0 ? 'is-active' : '' %>" href="/management?<%= baseQuery %>" data-mgmt-link>All</a>
          <% stageLegend.forEach(function(item) { %>
            <a class="legend-chip accent-<%= item.key %> <%= stageFilters.indexOf(item.label) !== -1 ? 'is-active' : '' %>"
               href="<%= toggleHref(item.label) %>"
               data-mgmt-link
               title="<%= item.meaning %>"><%= item.label %></a>
          <% }) %>
          <a class="legend-chip legend-free <%= stageFilters.indexOf('free') !== -1 ? 'is-active' : '' %>"
             href="<%= toggleHref('free') %>"
             data-mgmt-link>Free capacity</a>
          <span class="legend-chip legend-absence" title="Days a person is away. Capacity is removed for these days, so free capacity drops with it.">Absence</span>
        </div>
        <input type="search" class="form-control form-control-sm inline-filter inline-filter-sm" data-timeline-filter
               placeholder="Filter person / project..." aria-label="Filter the timeline by person or project">
        <button class="btn btn-sm btn-outline-secondary timeline-fullpage-toggle" type="button"
                data-timeline-fullpage
                aria-pressed="false"
                title="Show the timeline full page (F)">
          <i class="bi bi-arrows-fullscreen me-1" aria-hidden="true"></i><span data-timeline-fullpage-label>Full page</span>
        </button>
      </div>
      <div class="card-body collapse show" id="collapseTimeline">
        <div class="timeline-scroll" data-scroll-key="management-timeline">
          <div class="timeline-grid" id="timelineGrid"
               data-perspective="<%= view.timeline.perspective %>"
               data-range-start="<%= view.timeline.startText %>"
               data-range-end-exclusive="<%= view.timeline.endExclusiveText %>"
               data-window-start="<%= view.timeline.windowStartText %>"
               data-window-end-exclusive="<%= view.timeline.windowEndExclusiveText %>"
               style="--timeline-units: <%= view.timeline.units.length %>;">
            <div class="timeline-head">
              <div class="timeline-person-head">Person</div>
              <div class="timeline-head-stack">
                <div class="timeline-groups" style="--timeline-units: <%= view.timeline.units.length %>;">
                  <% view.timeline.unitGroups.forEach(function(group) { %>
                    <div class="timeline-group" style="--group-span: <%= group.span %>;"><span><%= group.label %></span></div>
                  <% }) %>
                </div>
                <div class="timeline-units" style="--timeline-units: <%= view.timeline.units.length %>;">
                  <% view.timeline.units.forEach(function(unit) { %>
                    <div class="timeline-unit"><%= unit.label %></div>
                  <% }) %>
                </div>
              </div>
            </div>

            <% view.timeline.rows.forEach(function(row) { %>
              <div class="timeline-row" style="height: <%= row.height %>px;">
                <div class="timeline-person"
                     title="<%= row.person %> &middot; <%= row.capacityHours %>h capacity in this window
Committed: <%= row.committedHours %>h
Free: <%= row.freeHours %>h
Committed + free = <%= (row.committedHours + row.freeHours).toFixed(2) %>h
Soft booked on top: <%= row.softHours %>h<%= row.heldHours ? '\nReleased by holds: ' + row.heldHours + 'h' : '' %><%
%><% if (row.absentDays) { %>
Away <%= row.absentDays %>d, which removes <%= row.absenceHours %>h of capacity:<% row.absenceBands.forEach(function(band) { %>
  <%= band.kind %> <%= band.startDate %> &rarr; <%= band.endDate %> (<%= band.daysInWindow %>d in view)<% }) %><% } %>">
                  <a class="person-link" href="/management/people/<%= encodeURIComponent(row.person) %>?perspective=<%= perspective %>&units=<%= unitsToShow %>&period=<%= periodDirection %>"><%= row.person %></a>
                  <span class="timeline-person-load"><%= row.committedHours %>h / <%= row.capacityHours %>h (<%= row.utilizationPercent %>%)</span>
                  <%/* Assigning from the timeline saves a trip to the opportunity
                       page: the row already says who is free and when. */ %>
                  <button type="button" class="timeline-assign-btn"
                          data-timeline-assign
                          data-person="<%= row.person %>"
                          data-start="<%= view.timeline.windowStartText %>"
                          data-end="<%= view.timeline.windowEndText %>"
                          title="Assign <%= row.person %> to an opportunity for <%= view.window.label %>"
                          aria-label="Assign <%= row.person %> to an opportunity">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Assign</span>
                  </button>
                </div>
                <div class="timeline-lane" style="--timeline-units: <%= view.timeline.units.length %>;">
                  <div class="timeline-gridlines">
                    <% view.timeline.units.forEach(function(unit) { %><div class="timeline-gridline"></div><% }) %>
                  </div>
                  <% row.chips.forEach(function(chip) { %>
                    <div class="timeline-chip <%= chip.accentClass %> <%= chip.IsCommitted ? 'is-committed' : 'is-soft' %> <%= chip.IsOnHold ? 'is-on-hold' : '' %>"
                         data-assignment-id="<%= chip.Id %>"
                         data-opportunity-id="<%= chip.OpportunityId %>"
                         data-start="<%= chip.StartDate %>"
                         data-end="<%= chip.EndDate %>"
                         data-percent="<%= chip.AllocationPercent || 0 %>"
                         data-hours="<%= chip.AllocatedHours %>"
                         data-initial-hours="<%= chip.InitialAllocatedHours %>"
                         data-initial-percent="<%= chip.InitialPercent %>"
                         data-opportunity-hours="<%= chip.OpportunityHours %>"
                         data-capacity-hours="<%= row.capacityHours %>"
                         data-capacity-percent="<%= chip.capacityPercent %>"
                         data-holds="<%= chip.holds ? JSON.stringify(chip.holds) : '[]' %>"
                         data-stage-label="<%= stageStatusLabel(chip.Stage) %>"
                         data-person="<%= chip.PersonName %>"
                         style="left: <%= chip.geometry.left.toFixed(3) %>%; width: <%= chip.geometry.width.toFixed(3) %>%; top: <%= chip.geometry.top %>px;"
                         title="<%= chip.OpportunityName %> &middot; <%= chip.PersonName %>
<%= chip.StartDate %> &rarr; <%= chip.EndDate %> (<%= chip.businessDays %> working days)
Assigned: <%= chip.InitialAllocatedHours %>h = <%= chip.InitialPercent %>% of the <%= chip.OpportunityHours %>h project
Now on the bar: <%= chip.AllocatedHours %>h<%= chip.IsResized ? ' (resized)' : '' %>
In this window: <%= chip.windowHours %>h = <%= chip.capacityPercent %>% of <%= row.person %>'s <%= row.capacityHours %>h capacity<%= chip.IsCommitted ? '' : '\nSoft booking: does not consume capacity yet' %>">
                      <span class="timeline-chip-resizer start" data-edge="start" title="Drag to change the start date"></span>
                      <% chip.holdOverlays.forEach(function(hold) { %>
                        <span class="timeline-chip-hold"
                              style="left: <%= hold.left.toFixed(3) %>%; width: <%= hold.width.toFixed(3) %>%;"
                              title="On hold <%= hold.startDate %> &rarr; <%= hold.endDate %> (capacity free)"></span>
                      <% }) %>
                      <a class="timeline-chip-body" href="/opportunities/<%= chip.OpportunityId %>#assignments">
                        <span class="timeline-chip-title">
                          <% if (chip.IsOnHold) { %><i class="bi bi-pause-circle me-1" aria-hidden="true"></i><% } %><% if (!chip.IsCommitted) { %><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i><% } %><%= chip.OpportunityName %><%
                          %><span class="timeline-chip-stage <%= chip.accentClass %>"><%= stageStatusLabel(chip.Stage) %></span>
                        </span>
                        <span class="timeline-chip-meta" data-role="meta"><%
                          %><%= chip.InitialAllocatedHours %>h<%
                          %><% if (chip.IsResized) { %> &rarr; <%= chip.AllocatedHours %>h<% } %><%
                          %> &middot; <%= chip.capacityPercent %>% cap</span>
                      </a>
                      <span class="timeline-chip-resizer end" data-edge="end" title="Drag to change the end date"></span>
                    </div>
                  <% }) %>
                  <% row.freeChips.forEach(function(segment) { %>
                    <%
                      var breakdown = segment.parts.map(function(part) {
                        return part.name + ': ' + part.hours + 'h = ' + part.percent + '%';
                      }).concat(['Free: ' + segment.freeHours + 'h = ' + segment.freePercent + '%']).join('\n');
                      var fullyAbsent = segment.capacityHours === 0 && segment.absentDays > 0;
                      var absenceDetail = segment.absentDays
                        ? '\n' + segment.absences.map(function(a) {
                            return a.kind + ' ' + a.startDate + ' to ' + a.endDate + ' (' + a.daysInWindow + 'd here)';
                          }).join('\n')
                        : '';
                    %>
                    <div class="timeline-free<%= fullyAbsent ? ' is-absent' : '' %><%= segment.isOver ? ' is-over' : '' %><%= fullyAbsent ? '' : ' is-assignable' %>"
                         <% if (!fullyAbsent) { %>
                         data-timeline-assign
                         data-person="<%= row.person %>"
                         data-start="<%= segment.startText %>"
                         data-end="<%= segment.endText %>"
                         role="button" tabindex="0"
                         <% } %>
                         style="left: <%= segment.geometry.left.toFixed(3) %>%; width: <%= segment.geometry.width.toFixed(3) %>%; top: <%= segment.geometry.top %>px;"
                         title="<%= segment.groupLabel %> <%= segment.unitLabel %> &middot; <%= segment.capacityHours %>h capacity<%= segment.absentDays ? ' (' + segment.grossCapacityHours + 'h \u2212 ' + segment.absenceHours + 'h absence)' : '' %><%= fullyAbsent ? '\nAway for the whole period, so there is no capacity to share out.' : '\n' + breakdown + '\nTotal: ' + (segment.usedPercent + segment.freePercent).toFixed(2) + '%' %><%= segment.isOver ? '\nOver capacity by ' + segment.overHours + 'h: more is committed here than there are hours to give.' : '' %><%= segment.softHours ? '\nSoft booked on top: ' + segment.softHours + 'h = ' + segment.softPercent + '%' : '' %><%= absenceDetail %><%= fullyAbsent ? '' : '\nClick to assign ' + row.person + ' to an opportunity for this period.' %>">
                      <span class="timeline-free-label">
                        <% if (fullyAbsent) { %>
                          <span class="timeline-free-primary">Away <%= segment.absentDays %>d</span>
                          <span class="timeline-free-secondary">no capacity</span>
                        <% } else if (segment.isOver) { %>
                          <span class="timeline-free-primary">
                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i><%= segment.overHours %>h over
                          </span>
                          <span class="timeline-free-secondary"><%= segment.usedPercent %>%<% if (segment.absentDays) { %> &middot; <%= segment.absentDays %>d away<% } %></span>
                        <% } else { %>
                          <span class="timeline-free-primary"><%= segment.freeHours %>h free</span>
                          <span class="timeline-free-secondary"><%= segment.freePercent %>%<% if (segment.softHours) { %> &middot; <%= segment.softHours %>h soft<% } %><% if (segment.absentDays) { %> &middot; <%= segment.absentDays %>d away<% } %></span>
                        <% } %>
                      </span>
                    </div>
                  <% }) %>
                  <% row.absenceBands.forEach(function(band) { %>
                    <%
                      var bandRange = band.startDate + ' \u2192 ' + band.endDate;
                    %>
                    <div class="timeline-absence"
                         style="left: <%= band.geometry.left.toFixed(3) %>%; width: <%= band.geometry.width.toFixed(3) %>%; top: <%= band.geometry.top %>px;"
                         title="<%= band.kind %><%= band.note ? ' \u2014 ' + band.note : '' %>
<%= bandRange %><%= band.startsBefore || band.endsAfter ? ' (continues outside this window)' : '' %>
<%= band.daysInWindow %> working days here, removing <%= band.hours %>h of capacity">
                      <span class="timeline-absence-label">
                        <%= band.daysInWindow %>d off
                      </span>
                    </div>
                  <% }) %>
                  <% if (!row.chips.length && !row.freeChips.length && !row.absenceBands.length) { %>
                    <div class="timeline-empty">No scheduled work in this window</div>
                  <% } %>
                </div>
              </div>
            <% }) %>

            <% if (!view.timeline.rows.length) { %>
              <%- include('partials/empty-state', {
                esArt: 'timeline',
                esTitle: 'Nothing to display for the selected filters',
                esHint: 'Try a wider period, or clear a filter or two.'
              }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /#tabTimeline -->

  <!-- ═══════════════ Tab 4: People ═══════════════ -->
  <div class="tab-pane fade" id="tabPeople" role="tabpanel">

    <%- include('partials/period-filter', { pfId: 'People' }) %>

    <%
      // Manager counts as a people filter too, so this has to follow
      // the resolved selection rather than the Person dropdown alone.
      var filteredPeople = peopleSelectionActive
        ? people.filter(function(name) { return selectedPeople.indexOf(name) !== -1; })
        : people;
      var memberByName = {};
      view.people.forEach(function(member) { memberByName[member.person] = member; });
      function initialsOf(name) {
        return String(name || '').split(/\s+/).filter(Boolean).slice(0, 2)
          .map(function(part) { return part.charAt(0); }).join('').toUpperCase() || '?';
      }
      function toneOf(name) {
        var hash = 7;
        for (var i = 0; i < String(name).length; i++) hash = (hash * 131 + String(name).charCodeAt(i)) % 104729;
        return hash % 6;
      }
    %>
    <div class="card mb-4 people-table-card">
      <div class="card-header">
        <button type="button" class="card-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#collapsePeopleList" aria-expanded="true">
          <i class="bi bi-chevron-down" aria-hidden="true"></i><span><i class="bi bi-people me-2" aria-hidden="true"></i>People (<%= filteredPeople.length %>)</span>
        </button>
      </div>
      <div class="card-body collapse show p-0" id="collapsePeopleList">
        <div class="table-responsive">
          <table class="table align-middle mb-0 people-table" id="peopleListTable">
            <thead>
              <tr>
                <th>Name</th>
                <th class="col-w200">Role</th>
                <th class="col-w180">Manager</th>
                <th class="text-end col-w100">Daily hours</th>
                <th class="text-end col-w120">Cost (<%= costCurrency %>/day)</th>
                <th class="text-center col-w100">Absences</th>
                <th class="col-w180" title="Committed hours ÷ capacity in the window">Utilization</th>
                <th class="text-end col-w100">Target</th>
                <th class="col-w140">Status</th>
                <th class="col-w180" title="Includes soft bookings">Predicted</th>
                <th class="col-w80"></th>
              </tr>
            </thead>
            <tbody>
              <% filteredPeople.forEach(function(personName) {
                var dailyHours = peopleDailyHours[personName] || hoursPerDay;
                var role = peopleRoles[personName] || '—';
                var cost = peopleCosts[personName];
                var absences = allAbsences[personName] || [];
                var manager = peopleManagers[personName];
                var member = memberByName[personName];
                var personHref = '/management/people/' + encodeURIComponent(personName) + '?perspective=' + perspective + '&units=' + unitsToShow + '&period=' + periodDirection;
              %>
                <tr>
                  <td>
                    <a href="<%= personHref %>" class="person-cell">
                      <span class="avatar avatar-tone-<%= toneOf(personName) %>" aria-hidden="true"><%= initialsOf(personName) %></span><%= personName %>
                    </a>
                  </td>
                  <td class="text-muted small"><%= role %></td>
                  <td class="small">
                    <% if (manager) { %>
                      <span class="person-cell person-cell--plain">
                        <span class="avatar avatar-sm avatar-tone-<%= toneOf(manager) %>" aria-hidden="true"><%= initialsOf(manager) %></span><%= manager %>
                      </span>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td class="text-end"><%= dailyHours %>h</td>
                  <td class="text-end"><%= cost !== undefined && cost !== null ? cost : '—' %></td>
                  <td class="text-center">
                    <% if (absences.length) { %>
                      <span class="count-badge"><%= absences.length %></span>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (member) { %>
                      <div class="util-cell" title="<%= member.activeHours %>h committed of <%= member.capacityHours %>h capacity">
                        <span class="util-value <%= member.chargeabilityClass %>"><%= member.chargeabilityReal %>%</span>
                        <span class="util-track"><span class="util-fill" style="width: <%= Math.min(member.chargeabilityReal, 100) %>%;"></span></span>
                      </div>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td class="text-end"><%= member ? member.chargeabilityTarget : peopleTargets[personName] %>%</td>
                  <td class="small">
                    <% if (member) { %>
                      <span class="rag-line rag-line--<%= member.chargeabilityStatus.tone %>"><%- ragDot(member.chargeabilityStatus) %><%= member.chargeabilityStatus.label %></span>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td>
                    <% if (member) { %>
                      <div class="util-cell" title="<%= member.activeHours + member.softHours %>h committed and soft booked of <%= member.capacityHours %>h capacity">
                        <span class="util-value <%= member.chargeabilityPredictedClass %>"><%= member.chargeabilityPredicted %>%</span>
                        <span class="util-track"><span class="util-fill util-fill--soft" style="width: <%= Math.min(member.chargeabilityPredicted, 100) %>%;"></span></span>
                      </div>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td class="text-end">
                    <a href="<%= personHref %>" class="btn btn-sm btn-outline-primary btn-pill">Details</a>
                  </td>
                </tr>
              <% }) %>
              <% if (!filteredPeople.length) { %>
                <tr><td colspan="11" class="text-center text-muted py-4">No people match the current filters.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div><!-- /#tabPeople -->

</div><!-- /.tab-content -->
