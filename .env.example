# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me

# Azure SQL
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=opportunities
# Leave user/password empty when running in Azure: the app then signs in with
# its managed identity instead.
AZURE_SQL_USER=app_user
AZURE_SQL_PASSWORD=
AZURE_SQL_ENCRYPT=true

# Optional: writable location for config.local.json. Defaults to the project
# root; Azure App Service sets this to persistent storage under /home.
# OPP_CONFIG_FILE=/home/data/config.local.json
