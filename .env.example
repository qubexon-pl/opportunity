# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me

# Azure SQL
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=opportunities
AZURE_SQL_AUTH=password
AZURE_SQL_USER=app_user
AZURE_SQL_PASSWORD=
AZURE_SQL_ENCRYPT=true

# Sign-in (App Service Authentication / Entra ID)
# AUTH_PROVIDER=easyauth
# AUTH_REQUIRED=true
# Local development only: act as this person
# DEV_USER_NAME=
# DEV_USER_EMAIL=

# How often each instance re-reads shared settings from SQL (ms)
# SETTINGS_REFRESH_MS=5000
