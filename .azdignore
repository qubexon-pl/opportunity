# Keep the deployment package small. Azure installs dependencies itself.
node_modules/
.git/
.azure/
infra/
scripts/

# Local-only
# Note: azd 1.25.6 only honors directory patterns; file patterns below take
# effect on newer azd. Shipping these files is harmless (runtime config comes
# from OPP_CONFIG_FILE on persistent storage).
**/.env
**/config.local.json

# Not needed at runtime
**/tmp-*.js
**/*.md
.github/
